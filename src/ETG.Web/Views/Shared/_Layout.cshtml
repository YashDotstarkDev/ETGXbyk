<!DOCTYPE html>
<html lang="en-au">
<head>
    <vc:page-custom-meta />

    <!-- PERFORMANCE: Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <!-- PERFORMANCE: Critical CSS inline or preloaded -->
    <link rel="preconnect" href="@ImgixExtensions.ImgixDomain" crossorigin>

    <link href="~/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/minified/css/style.min.css" rel="stylesheet" asp-append-version="true" />

    <!-- PERFORMANCE: Async load fonts - non-blocking -->
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet"></noscript>

    <!-- PERFORMANCE: Async load icon fonts -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" media="print" onload="this.media='all'">
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" media="print" onload="this.media='all'">
    
    @if (Context.Kentico().PageBuilder().EditMode)
    {
        <page-builder-styles />
    }

    @RenderSection("Styles", required: false)

    <!-- PERFORMANCE: Font Awesome moved to bottom with defer -->
    <!-- PERFORMANCE: Imgix fallback handler -->
    <script>
        window.addEventListener('error', function (event) {
            var target = event.target;
            if (target && target.tagName === 'IMG') {
                var currentSrc = target.src || '';
                if (currentSrc.indexOf('.imgix.net') !== -1 && !target.dataset.fallbackTried) {
                    target.dataset.fallbackTried = 'true';
                    try {
                        var url = new URL(currentSrc);
                        console.warn('[Imgix Fallback] Failed to load:', currentSrc, '=> Falling back to origin:', url.pathname);
                        target.removeAttribute('srcset');
                        if (target.parentElement && target.parentElement.tagName === 'PICTURE') {
                            var sources = target.parentElement.querySelectorAll('source');
                            sources.forEach(function (s) { s.remove(); });
                        }
                        target.src = url.pathname;
                    } catch (e) { }
                }
            }
        }, true);
    </script>
</head>

<body class="d-flex flex-column min-vh-100">

   <vc:top-navigation/>
   <vc:navigation/>

    <main class="flex-grow-1">
        @RenderBody()       
    </main>

    <vc:subscribe-now />
    <vc:footer />
    <vc:tracking-consent />

    @if (Context.Kentico().PageBuilder().EditMode)
    {
        <page-builder-scripts />
    }

    <!-- PERFORMANCE: All JavaScript at bottom with defer/async -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js" defer></script>
    <script src="https://kit.fontawesome.com/d67a31d7e1.js" crossorigin="anonymous" defer></script>
    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
 <script src="~/minified/js/script.min.js" asp-append-version="true" defer></script>
    <script src="~/minified/js/utmscripts.min.js" asp-append-version="true" defer></script>

    @RenderSection("Scripts", required: false)

</body>
</html>