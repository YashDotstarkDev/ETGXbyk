@using ETG.Core.Models.Tour
@using ETG.Core.Content
@using static ETG.Web.Features.TourPackage.TourPageTemplateController
@model ETG.Core.Content.Tour

@{
    var tour = Model;
    var heroimages = tour.SelectedImageFolders?
        .Where(folder => folder?.SelectedImages != null)
        .SelectMany(folder => folder.SelectedImages)
        .OfType<ETG.Image>()
        .Where(image => image != null)
        .ToList()
        ?? new List<ETG.Image>();

    var total = heroimages.Count;
    var tourName = tour?.TourName?.Trim();
    var lastSpaceIndex = tourName?.LastIndexOf(' ') ?? -1;

    var shareLinks = ViewData["ShareLinks"] as ShareLinksViewModel;
}

    <section class="pkgd-hero">
        <div class="pkgd-hero__counter" id="pkgdCounter">1 / @total</div>
        <div class="pkgd-hero__track" id="pkgdTrack">
        @foreach (var images in heroimages)
        {
            var mediaFile = images.ImageFilePath?
                            .OfType<MediaFile>()
                            .FirstOrDefault();

            var imageUrl = mediaFile?.LegacyMediaFileAsset?.Url;

            <div class="pkgd-hero__slide">  
                @if (!string.IsNullOrWhiteSpace(imageUrl))
                {
                    <img src="@Url.Content(imageUrl)" alt="@images.ImageAltText" loading="lazy" />
                }                        
            </div>
        }
        </div>

        <button class="pkgd-hero__arrow pkgd-hero__arrow--prev" id="pkgdPrev" aria-label="Previous image">
            <i class="bi bi-arrow-left"></i>
        </button>
        <button class="pkgd-hero__arrow pkgd-hero__arrow--next" id="pkgdNext" aria-label="Next image">
            <i class="bi bi-arrow-right"></i>
        </button>

        <div class="pkgd-hero__titlebar">
        @if (!string.IsNullOrWhiteSpace(tour.TourName))
        {
            <h1 class="about-hero-title text-white fw-bold display-4">
                @tourName.Substring(0, lastSpaceIndex)
                <span class="text-pink">
                    @tourName.Substring(lastSpaceIndex + 1)
                </span>
            </h1>
        }
        </div>
    @if (shareLinks is not null)
    {
        <a href="#"  class="pkg-icon" id="shareTrigger" aria-haspopup="true" aria-expanded="false" aria-controls="sharePanel">
            <img src="https://preview.dotstark.com/images/icons_share.svg" alt="Share">
        </a>
    }

    @if (shareLinks is not null)
    {
        <div class="share-panel" id="sharePanel" role="menu" aria-hidden="true">
            <div class="share-panel__header">
                <span class="share-panel__title">
                    Share via
                </span>
                <button class="share-panel__close"  id="shareClose" aria-label="Close share menu">
                    &times;
                </button>
            </div>

            <div class="share-grid">
                @if (!string.IsNullOrWhiteSpace(@shareLinks?.PinterestShareUrl))
                {
                <!-- Pinterest -->
                <button class="share-grid__item"
                data-network="pinterest"
                data-share-url="@shareLinks?.PinterestShareUrl"
                role="menuitem">
                    <span class="share-grid__icon-wrap">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 2C6.48 2 2 6.48 2 12c0 4.1 2.47 7.62 6 9.17-.03-.78-.01-1.71.19-2.56l1.4-5.93s-.35-.7-.35-1.73c0-1.62.94-2.83 2.11-2.83.99 0 1.47.74 1.47 1.63 0 .99-.63 2.47-.95 3.85-.27 1.15.58 2.08 1.71 2.08 2.06 0 3.65-2.17 3.65-5.3 0-2.77-1.99-4.71-4.83-4.71-3.29 0-5.22 2.47-5.22 5.02 0 .99.38 2.05.86 2.63.09.11.1.21.07.32l-.32 1.3c-.05.21-.17.26-.39.16-1.45-.67-2.36-2.79-2.36-4.49 0-3.65 2.65-7 7.64-7 4.01 0 7.13 2.86 7.13 6.68 0 3.98-2.51 7.19-5.99 7.19-1.17 0-2.27-.61-2.65-1.33l-.72 2.75c-.26 1-.96 2.26-1.43 3.03.96.29 1.97.45 3.01.45 5.52 0 10-4.48 10-10S17.52 2 12 2Z" />
                        </svg>
                    </span>
                    <span class="share-grid__label">
                        Pinterest
                    </span>
                </button>
                }

                @if (!string.IsNullOrWhiteSpace(@shareLinks?.TwitterShareUrl))
                {
                <!-- X -->
                <button class="share-grid__item"
                data-network="x"
                data-share-url="@shareLinks?.TwitterShareUrl"
                role="menuitem">
                    <span class="share-grid__icon-wrap">
                        <svg viewBox="0 0 24 24">
                            <path d="M18.9 2H22l-7.6 8.68L23.3 22h-6.9l-5.4-7.06L4.9 22H1.8l8.13-9.29L1 2h7.06l4.88 6.45L18.9 2Zm-1.21 18h1.7L7.4 3.9H5.58L17.69 20Z" />
                        </svg>
                    </span>
                    <span class="share-grid__label">
                        Twitter
                    </span>
                </button>
                }

                @if (!string.IsNullOrWhiteSpace(@shareLinks?.FacebookShareUrl))
                {
                <!-- Facebook -->
                <button class="share-grid__item"
                data-network="facebook"
                data-share-url="@shareLinks?.FacebookShareUrl"
                role="menuitem">
                    <span class="share-grid__icon-wrap">
                        <svg viewBox="0 0 24 24">
                            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
                        </svg>
                    </span>
                    <span class="share-grid__label">
                        Facebook
                    </span>
                </button>
                }

                @if (!string.IsNullOrWhiteSpace(@shareLinks?.LinkedInShareUrl))
                {
                <!-- LinkedIn -->
                <button class="share-grid__item"
                data-network="linkedin"
                data-share-url="@shareLinks?.LinkedInShareUrl"
                role="menuitem">
                    <span class="share-grid__icon-wrap">
                        <svg viewBox="0 0 24 24">
                            <path d="M20.45 2H3.54C2.7 2 2 2.68 2 3.52v16.96C2 21.32 2.7 22 3.54 22h16.91c.85 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.3 2 20.45 2ZM8.09 18.74h-3V9.4h3ZM6.59 8.1a1.75 1.75 0 1 1 0-3.5 1.75 1.75 0 0 1 0 3.5Zm12.15 10.64h-3v-4.54c0-1.08-.02-2.47-1.5-2.47-1.51 0-1.74 1.18-1.74 2.4v4.61h-3V9.4h2.88v1.28h.04c.4-.76 1.38-1.55 2.84-1.55 3.04 0 3.6 2 3.6 4.59Z" />
                        </svg>
                    </span>
                    <span class="share-grid__label">
                        LinkedIn
                    </span>
                </button>
                }

                @if (!string.IsNullOrWhiteSpace(@shareLinks?.CopyUrl))
                {
                <!-- Copy Link -->
                <button class="share-grid__item"
                data-network="copy"
                data-share-url="@shareLinks?.CopyUrl"
                role="menuitem">
                    <span class="share-grid__icon-wrap">
                        <svg viewBox="0 0 24 24">
                            <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12Zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2Zm0 16H8V7h11Z" />
                        </svg>
                    </span>
                    <span class="share-grid__label">
                        Copy link
                    </span>
                </button>
                }
            </div>
        </div>
    }

    </section>


@if (total > 1)
{
    <script>
        (function() {

            const track = document.getElementById('pkgdTrack');
            const counter = document.getElementById('pkgdCounter');
            const total = @total;

            let current = 0;

            function goTo(index) {

                current = (index + total) % total;

                track.style.transform =
                    `translateX(-${current * 100}%)`;

                counter.textContent =
                    `${current + 1} / ${total}`;
            }

            document.getElementById('pkgdPrev')?.addEventListener(
                'click',
                () => goTo(current - 1)
            );

            document.getElementById('pkgdNext')?.addEventListener(
                'click',
                () => goTo(current + 1)
            );

        })();
    </script>
}

<script>
    // Desktop Mega Menu Logic
    document.querySelectorAll('.sidebar-btn').forEach(btn => {
        btn.addEventListener('mouseenter', () => {
            document.querySelectorAll('.sidebar-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(btn.dataset.panel).classList.add('active');
        });
    });

    // Mobile Toggle Logic (Level 1 and 2)
    function toggleMob(id) {
        const el = document.getElementById(id);
        el.classList.toggle('show'); // This handles the sub-containers

        // Toggle Icon
        const trigger = el.previousElementSibling.querySelector('i');
        if (trigger.classList.contains('bi-chevron-down')) trigger.classList.replace('bi-chevron-down', 'bi-chevron-up');
        else if (trigger.classList.contains('bi-chevron-up')) trigger.classList.replace('bi-chevron-up', 'bi-chevron-down');
        else if (trigger.classList.contains('bi-plus')) trigger.classList.replace('bi-plus', 'bi-dash');
        else if (trigger.classList.contains('bi-dash')) trigger.classList.replace('bi-dash', 'bi-plus');
    }

    (function() {
        var trigger = document.getElementById('shareTrigger');
        var panel = document.getElementById('sharePanel');
        var closeBtn = document.getElementById('shareClose');
        var items = panel.querySelectorAll('.share-grid__item');

        // stagger each grid icon's transition so they cascade in on open
        items.forEach(function(item, i) {
            item.style.transitionDelay = (i * 35) + 'ms';
        });

        function openPanel() {
            panel.classList.add('is-open');
            panel.setAttribute('aria-hidden', 'false');
            trigger.classList.add('is-active');
            trigger.setAttribute('aria-expanded', 'true');
            document.addEventListener('click', handleOutsideClick);
            document.addEventListener('keydown', handleEscape);
        }

        function closePanel() {
            panel.classList.remove('is-open');
            panel.setAttribute('aria-hidden', 'true');
            trigger.classList.remove('is-active');
            trigger.setAttribute('aria-expanded', 'false');
            document.removeEventListener('click', handleOutsideClick);
            document.removeEventListener('keydown', handleEscape);
        }

        function togglePanel(e) {
            e.preventDefault();
            e.stopPropagation();
            var isOpen = panel.classList.contains('is-open');
            isOpen ? closePanel() : openPanel();
        }

        function handleOutsideClick(e) {
            if (!panel.contains(e.target) && e.target !== trigger) {
                closePanel();
            }
        }

        function handleEscape(e) {
            if (e.key === 'Escape') closePanel();
        }

        trigger.addEventListener('click', togglePanel);
        closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            closePanel();
        });

        items.forEach(function(item) {
            item.addEventListener('click', async function(event) {
                event.preventDefault();
                event.stopPropagation();

                const network = item.dataset.network;
                const shareUrl = item.dataset.shareUrl;

                if (!shareUrl) {
                    console.error('Share URL is missing:', network);
                    return;
                }

                // Copy the current page URL
                if (network === 'copy') {
                    try {
                        await navigator.clipboard.writeText(shareUrl);

                        const label = item.querySelector('.share-grid__label');

                        if (label) {
                            const originalText = label.textContent;
                            label.textContent = 'Copied!';

                            setTimeout(function() {
                                label.textContent = originalText;
                            }, 2000);
                        }
                    } catch (error) {
                        console.error('Clipboard API failed:', error);

                        // Fallback for browsers where Clipboard API is unavailable
                        const textarea = document.createElement('textarea');

                        textarea.value = shareUrl;
                        textarea.style.position = 'fixed';
                        textarea.style.opacity = '0';

                        document.body.appendChild(textarea);
                        textarea.select();

                        try {
                            const copied = document.execCommand('copy');

                            if (copied) {
                                const label =
                                    item.querySelector('.share-grid__label');

                                if (label) {
                                    const originalText = label.textContent;
                                    label.textContent = 'Copied!';

                                    setTimeout(function() {
                                        label.textContent = originalText;
                                    }, 2000);
                                }
                            } else {
                                console.error('Unable to copy the URL.');
                            }
                        } finally {
                            textarea.remove();
                        }
                    }

                    closePanel();
                    return;
                }

                // Open social sharing page in a new tab
                const newTab = window.open(
                    shareUrl,
                    '_blank',
                    'noopener,noreferrer'
                );

                if (!newTab) {
                    console.warn('The browser may have blocked the new tab.');
                }

                closePanel();
            });
        });
    })();
</script>