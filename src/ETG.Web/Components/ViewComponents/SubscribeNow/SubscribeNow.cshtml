@model ETG.Web.Components.ViewComponents.SubscribeNow.SubscribeNowViewModel

<style>
    .subscribe-now-form[hidden] {
        display: none !important;
    }

    .subscribe-now-form
    .ts-wrapper.tom-select:not(.has-items)
    .ts-control::before {
        content: "Are you a agent?";
        display: block;
        color: #212529;
        font-size: 0.85rem;
        font-weight: normal;
        padding-left: .45rem;
        pointer-events: none;
    }
</style>

<section class="subscribe-section" style="padding: 25px 0;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-4 mb-3 mb-lg-0">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-envelope text-pink"
                       style="font-size: 2.2rem; font-weight: 300;"></i>

                    <div class="text-white">
                        <h4 class="mb-0 fw-bold"
                            style="font-size: 1.1rem; text-transform: capitalize; letter-spacing: 0;">
                            Subscribe Now
                        </h4>
                        <p class="mb-0 text-white"
                           style="font-size: 0.8rem; opacity: 0.8; letter-spacing: 0;
                            line-height: 1.2; font-weight: normal; text-transform: none;">
                            Win a $500 Travel Voucher
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <form asp-controller="Form"
                      asp-action="SubscribeNow"
                      method="post"
                      novalidate
                      class="subscribe-now-form d-flex flex-column flex-md-row gap-3 w-100 m-0 align-items-stretch">

                    @Html.AntiForgeryToken()

                    <input asp-for="EmailAddress"
                           type="email"
                           required
                           maxlength="254"
                           pattern="[A-Za-z0-9._%+\-]+@@[A-Za-z0-9]([A-Za-z0-9\-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9\-]*[A-Za-z0-9])?)+"
                           class="form-control flex-grow-1"
                           placeholder="Your email address"
                           aria-label="Email"
                           style="font-size: 0.85rem; padding: .45rem;" />

                    <select asp-for="IsTravelAgent"
                            required
                            class="form-select flex-grow-1 tom-select"
                            aria-label="Are you a agent?"
                            style="font-size: 0.85rem;">
                        <option value="">Are you a agent?</option>
                        <option value="Yes" class="text-dark">Yes</option>
                        <option value="No" class="text-dark">No</option>
                    </select>

                    <button type="submit"
                            class="btn btn-pink px-4 m-0 text-white fw-bold"
                            style="border-radius: 4px; font-size: 0.85rem; padding: 6px 24px;">
                        Subscribe
                    </button>
                </form>

                <p class="subscribe-now-result mt-2 mb-0"
                   role="status"
                   aria-live="polite"
                   style="font-size: 16px !important; line-height: 1.5;
                font-weight: 400 !important; white-space: pre-line;"
                   hidden></p>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
        const section = document.currentScript.previousElementSibling;
        const form = section.querySelector(".subscribe-now-form");
        const result = section.querySelector(".subscribe-now-result");
        const button = form.querySelector('button[type="submit"]');
        const email = form.querySelector('[name="EmailAddress"]');
        const agent = form.querySelector('[name="IsTravelAgent"]');

        function showMessage(message, success) {
            result.textContent = message;
            result.classList.toggle("text-danger", !success);
            result.classList.toggle("text-white", success);
            result.hidden = false;
        }

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            result.hidden = true;

            if (!email.value.trim()) {
                showMessage("Please enter your email address.", false);
                email.focus();
                return;
            }

            if (!email.checkValidity()) {
                showMessage("Please enter a valid email address.", false);
                email.focus();
                return;
            }

            if (!["Yes", "No"].includes(agent.value)) {
                showMessage("Please select whether you are a travel agent.", false);
                agent.focus();
                return;
            }

            button.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    credentials: "same-origin"
                });

                const data = await response.json();
                showMessage(
                    data.message || "Something went wrong.",
                    response.ok
                );

                if (response.ok) {
                    form.hidden = true;
                }
            } catch {
                showMessage(
                    "Unable to submit right now. Please try again.",
                    false
                );
            } finally {
                button.disabled = false;
            }
        });
    })();
</script>