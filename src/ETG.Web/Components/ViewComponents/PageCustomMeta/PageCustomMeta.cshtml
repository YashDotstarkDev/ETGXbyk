@using ETG.Web.Components.ViewComponents.PageCustomMeta
@model PageCustomMetaViewModel

    <meta name="viewport" content="width=device-width" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
    <meta name="msapplication-TileColor" content="#fc3dff">
    <meta name="theme-color" content="#ffffff">
    <meta name="msapplication-TileColor" content="#ca568e" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:locale" content="en_US" />
    <meta name="title" property="og:title" content="@Model.Title" />
    <meta name="description" property="og:description" content="@Model.Description" />
    <meta name="type" property="og:type" content="website" />
    <meta property="og:url" content="@Model.CanonicalUrl" />
    <meta property="og:site_name" content="@Model.site_name" />
    <meta name="apple-mobile-web-app-title" content="@Model.Title">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="author" content="">
    <meta name="facebook-domain-verification" content="ng94q71cwn2e7xeqarcf0tkr5y7xwi" />
    <link rel="canonical" href="@Model.CanonicalUrl" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <link rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#ca568e" />
    
    @if (!string.IsNullOrWhiteSpace(Model.Title)
        && !string.IsNullOrWhiteSpace(Model.ShareImage))
    {
     <meta property="og:image" content="@Model.ShareImage" />
     <meta property="og:image:height" content="780" />
     <meta property="og:image:width" content="1500" />
    }
       
    @if (!string.IsNullOrWhiteSpace(Model.GoogleVerificationCode))
    {
     <meta name="google-site-verification" content="@Model.GoogleVerificationCode" />
    }