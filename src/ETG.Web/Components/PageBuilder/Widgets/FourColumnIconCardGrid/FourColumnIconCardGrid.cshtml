@using ETG.Web.Components.PageBuilder.Widgets.FourColumnIconCardGrid

@model FourColumnIconCardGridWidgetViewModel

<section class="section-pad bg-lightgray" aria-labelledby="expertise-title">
    <div class="container">

        @if (!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <div class="title-div">
               <h2 id="expertise-title" class="section-title">@Model.Heading</h2>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <p class="text-muted mb-4" style="max-width:640px">@Model.ShortDescription</p>
        }

        @if (Model.FeaturesCards?.Any() == true)
        {
            <div class="row g-4 text-center">

                @foreach (var card in Model.FeaturesCards)
                {
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="expertise-card h-100 p-4 bg-white rounded-4 shadow-sm border border-light">

                            @{
                                var image = card.CardImage?.FirstOrDefault();
                                var imageAsset = image?.LegacyMediaFileAsset;
                                var alttext = imageAsset?.Metadata?.Name ?? "";
                            }

                            @if (imageAsset is not null)
                            {
                                <div class="expertise-icon-wrap mb-3 mx-auto">
                                    <img kxp-img="@imageAsset" width="20px" alt="@alttext" srcset="" />
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(card.CardLinkTitle))
                            {
                                <h3 class="expertise-number text-pink fw-bold mb-2">@card.CardLinkTitle</h3>
                            }

                            @if (!string.IsNullOrWhiteSpace(card.BasicItemTitle))
                            {
                                <h6 class="fw-bold text-dark mb-2">@card.BasicItemTitle</h6>
                            }

                            @if (!string.IsNullOrWhiteSpace(card.BasicItemShortDescription))
                            {
                                <p class="small text-muted mb-0">@card.BasicItemShortDescription</p>
                            }

                        </div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.FooterText))
        {
            <div class="text-center mt-5 text-muted" style="font-size: 0.85rem;">@Model.FooterText</div>
        }

    </div>
</section>