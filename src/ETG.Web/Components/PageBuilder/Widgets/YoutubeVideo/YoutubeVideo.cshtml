@model ETG.Web.Components.PageBuilder.Widgets.YoutubeVideo.YoutubeVideoWidgetViewModel

@{
    var widgetId = $"youtube-video-{Guid.NewGuid():N}";
    var iframeId = $"{widgetId}-iframe";
    var overlayId = $"{widgetId}-overlay";
    var youtubeId = Uri.EscapeDataString(Model.YoutubeID ?? string.Empty);
}

@if (!string.IsNullOrWhiteSpace(Model.YoutubeID))
{
    <section class="about-video bg-lightgray section-pad">
        <div class="container text-center">
            <div id="@widgetId"
                class="about-video-wrapper position-relative overflow-hidden rounded-4 shadow-sm ratio ratio-16x9 mx-auto"
                style="background: #000;"
                data-youtube-url="https://www.youtube.com/watch?v=@youtubeId"
                data-open-in-new-window="@Model.OpenInNewWindow.ToString().ToLowerInvariant()">

                <iframe id="@iframeId"
                        src="https://www.youtube.com/embed/@youtubeId?rel=0"
                        title="@(string.IsNullOrWhiteSpace(Model.Caption) ? "YouTube video player" : Model.Caption)"
                        style="border: 0;"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>

                <div id="@overlayId"
                     class="w-100 h-100 position-absolute top-0 start-0 d-flex align-items-center justify-content-center"
                     style="z-index: 1; pointer-events: none;">

                    <div class="position-absolute top-50 start-50 translate-middle"
                         style="z-index: 1;">
                        <button type="button"
                                class="about-video-play-btn btn btn-link p-0 text-white"
                                aria-label="@(Model.OpenInNewWindow ? "Open video on YouTube in a new window" : "Play " + Model.Caption)"
                                style="pointer-events: auto;">
                            <i class="bi bi-play-circle-fill"
                               style="font-size: 5rem; color: var(--etg-pink, #CA568E); background: radial-gradient(white 40%, transparent 40%); border-radius: 50%;"></i>
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Caption))
                    {
                        <p class="about-video-caption position-absolute bottom-0 start-50 translate-middle-x text-white fw-semibold text-center mb-3"
                           style="z-index: 1;">
                            @Model.Caption
                        </p>
                    }
                </div>

                @if (Model.OpenInNewWindow)
                {
                    <a href="https://www.youtube.com/watch?v=@youtubeId"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Open video on YouTube in a new window"
                       class="position-absolute top-0 start-0 w-100 h-100"
                       style="z-index: 2;">
                    </a>
                }
            </div>
        </div>
    </section>

    <script>
        (() => {
            const wrapper = document.getElementById("@widgetId");
            const iframe = document.getElementById("@iframeId");
            const overlay = document.getElementById("@overlayId");
            const playButton = overlay.querySelector(".about-video-play-btn");

            if (wrapper.dataset.openInNewWindow === "true") {
                playButton.addEventListener("click", () => {
                    window.open(
                        wrapper.dataset.youtubeUrl,
                        "_blank",
                        "noopener,noreferrer"
                    );
                });
                return;
            }

            const removeOverlay = () => {
                overlay.remove();
            };

            playButton.addEventListener("click", () => {
                const videoUrl = new URL(iframe.src);
                videoUrl.searchParams.set("autoplay", "1");
                iframe.src = videoUrl.toString();
                removeOverlay();
            });

            // Hide the custom overlay if the native player receives focus.
            iframe.addEventListener("focus", removeOverlay, { once: true });
        })();
    </script>
}