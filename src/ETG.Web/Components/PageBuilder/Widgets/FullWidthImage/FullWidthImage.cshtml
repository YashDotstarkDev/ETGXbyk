@using ETG.Web.Components.PageBuilder.Widgets.FullWidthImage
@model FullWidthImageWidgetViewModel

<div class="widget full-width-image" data-widget="full-width-image">
    <div class="image">
        @if (!string.IsNullOrEmpty(Model.Image?.LegacyMediaFileAsset?.Url))
        {
            <img src="@Model.Image.LegacyMediaFileAsset.Url"
                 class="lazyload"
                 data-src="@Model.Image.LegacyMediaFileAsset.Url"
                 alt="@(string.IsNullOrEmpty(Model.Caption) ? (Model.Image.LegacyMediaFileTitle ?? "Full Width Image") : Model.Caption)" />
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.Caption))
    {
        <div class="caption">
            @Model.Caption
        </div>
    }
</div>