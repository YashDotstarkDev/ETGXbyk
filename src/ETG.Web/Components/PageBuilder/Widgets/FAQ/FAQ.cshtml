@using ETG.Web.Components.PageBuilder.Widgets.FAQ

@model FAQWidgetViewModel

@if (Model != null)
{
    var faqItems = Model.FAQItems ?? [];
    var faqCtaText = Model.FaqCtaText ?? "";
    var faqCtaLink = Model.FaqCtaLink ?? "#";

    <section class="section-pad" aria-labelledby="faq-title-@Model.WidgetInstanceID">
        <div class="container">
            @if (Model.HasLabel || !Model.HideViewAll)
            {
                <div class="d-flex justify-content-between align-items-end mb-4 title-div">
                    @if (Model.HasLabel && !string.IsNullOrWhiteSpace(Model.DisplayLabel))
                    {
                        <h2 id="faq-title-@Model.WidgetInstanceID" class="section-title">
                            @Model.DisplayLabel
                        </h2>
                    }

                    @if (!Model.HideViewAll)
                    {
                        <a href="@faqCtaLink" class="view-all-btn">
                            @faqCtaText
                        </a>
                    }
                </div>
            }

            @if (faqItems.Any())
            {
                <div class="accordion" id="faqAccordion-@Model.WidgetInstanceID">
                    @foreach (var (item, index) in faqItems.Select((item, index) => (item, index)))
                    {
                        if (item == null)
                        {
                            continue;
                        }

                        var itemId = $"faq-{Model.WidgetInstanceID}-{index}";
var question = item.Question ?? "";
var answer = item.AnswerHtml ?? "" ;

                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@itemId"
                                        aria-expanded="false"
                                        aria-controls="@itemId">
                                    @question
                                </button>
                            </h3>

                            <div id="@itemId"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#faqAccordion-@Model.WidgetInstanceID">
                                <div class="accordion-body">
                                    @Html.Raw(answer)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}