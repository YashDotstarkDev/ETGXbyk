@using ETG.Web.Components.PageBuilder.Widgets.GoogleReviews
@using ETG.Web.Services.GoogleReviews

@model GoogleReviewsWidgetViewModel

@{
    var displayedReviews = Model.Reviews.Reviews
        .Where(r => !string.IsNullOrWhiteSpace(r.Text))
        .Take(4)
        .ToList();
    double avg = Model.Reviews.Totals.AverageRating;
    int fullStars = (int)Math.Floor(avg);
    bool halfStar = (avg - fullStars) >= 0.5;
    int emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
}

<section class="section-pad bg-white" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="title-div mb-4">
      <div class="d-flex flex-row justify-content-between align-items-center gap-3">

        @if (!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h2 id="testimonials-title" class="section-title mb-0">
                @Model.Heading
            </h2>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ViewAllUrl))
        {
            <a href="@Model.ViewAllUrl"
               class="view-all-btn"
               target="_blank"
               rel="noopener noreferrer">
                View All
            </a>
        }

      </div>

      <div class="text-warning mb-1 fs-5 mt-2"
           aria-label="@avg out of 5 stars">

        @for (int i = 0; i < fullStars; i++)
        {
                    <span aria-hidden="true"><i class="bi bi-star-fill"></i></span>
        }

        @if (halfStar)
        {
                    <span aria-hidden="true"><i class="bi bi-star-half"></i></span>
        }

        @for (int i = 0; i < emptyStars; i++)
        {
                    <span aria-hidden="true"><i class="bi bi-star"></i></span>
        }

      </div>

      <p class="text-muted small mb-0">
        @avg.ToString("0.0") Stars |
        @Model.Reviews.Totals.ReviewCount
        Review@(Model.Reviews.Totals.ReviewCount == 1 ? "" : "s")
      </p>
    </div>

    <div class="row g-4 text-start align-items-start">

      @foreach (var review in displayedReviews)
      {
          int rFull = (int)Math.Floor(review.Rating);
          int rEmpty = 5 - rFull;

          string cardId = $"review-text-{System.Math.Abs(review.Reviewer.GetHashCode())}-{review.DateTime.Ticks % 10000}";
          
          <div class="col-md-6 col-lg-3">
            <article class="p-4 rounded-3 border  d-flex flex-column review-card"
              style="border-color: #eaeaea !important; background: #fff;">

              <div class="mb-3">
                <div class="fw-medium text-dark">
                  @review.Reviewer
                </div>

                <div class="text-muted small">
                  @review.DateTime.ToRelativeText()
                </div>
              </div>

              <div class="text-warning mb-3"
                   style="font-size: 0.9rem; letter-spacing: 2px;"
                   aria-label="@review.Rating out of 5 stars">

                @for (int i = 0; i < rFull; i++)
                            {
                  <span aria-hidden="true"><i class="bi bi-star-fill"></i></span>
                }

                @for (int i = 0; i < rEmpty; i++)
                            {
                  <span aria-hidden="true"><i class="bi bi-star"></i></span>
                }

              </div>

              <p id="@cardId"
                 class="text-muted mb-3 flex-grow-1 review-text"
                 style="font-size: 0.9rem; line-height: 1.5;"
                 data-short="@review.Text"
                 data-full="@review.Text">
                @review.Text
              </p>

              @if (!string.IsNullOrWhiteSpace(review.Text))
              {
                  <a href="#"
                     class="text-pink text-decoration-none link-pink small read-more-btn"
                     aria-expanded="false"
                     aria-controls="@cardId"
                     data-target="#@cardId"
                     onclick="toggleReviewText(this); return false;">
                    Read more
                  </a>
              }

            </article>
          </div>
      }

    </div>
  </div>
</section>
