@using ETG.Web.Components.PageBuilder.Widgets.ImageGallery
@model ImageGalleryWidgetViewModel

@{
    var images = Model.Images.ToList();
}

<section class="gj-mosaic-section bg-lightgray" aria-label="Destinations Gallery">
    <div class="container">
        <div class="gj-mosaic-grid">

            <!-- Col 1 -->
            <div class="gj-mosaic-col">
                <div class="gj-cell gj-cell--a" data-lb>
                    @if (images.Count > 0)
                    {
                        <img loading="lazy"
                             src="@images[0].LegacyMediaFileAsset.Url"
                             alt="@images[0].LegacyMediaFileTitle"
                             class="gj-mosaic-img">
                    }
                </div>
                <div class="gj-cell gj-cell--d" data-lb>
                    @if (images.Count > 3)
                    {
                        <img loading="lazy"
                             src="@images[3].LegacyMediaFileAsset.Url"
                             alt="@images[3].LegacyMediaFileTitle"
                             class="gj-mosaic-img">
                    }
                </div>
            </div>

            <!-- Col 2 -->
            <div class="gj-mosaic-col">
                <div class="gj-cell gj-cell--b" data-lb>
                    @if (images.Count > 1)
                    {
                        <img loading="lazy"
                             src="@images[1].LegacyMediaFileAsset.Url"
                             alt="@images[1].LegacyMediaFileTitle"
                             class="gj-mosaic-img">
                    }
                </div>
                <div class="gj-cell gj-cell--e" data-lb>
                    @if (images.Count > 4)
                    {
                        <img loading="lazy"
                             src="@images[4].LegacyMediaFileAsset.Url"
                             alt="@images[4].LegacyMediaFileTitle"
                             class="gj-mosaic-img">
                    }
                </div>
            </div>

            <!-- Col 3 (wide) -->
            <div class="gj-mosaic-col gj-mosaic-col--wide">
                <div class="gj-cell gj-cell--c" data-lb>
                    @if (images.Count > 2)
                    {
                        <img loading="lazy"
                             src="@images[2].LegacyMediaFileAsset.Url"
                             alt="@images[2].LegacyMediaFileTitle"
                             class="gj-mosaic-img">
                    }
                </div>
                <div class="gj-mosaic-row-bottom">
                    <div class="gj-cell gj-cell--f" data-lb>
                        @if (images.Count > 5)
                        {
                            <img loading="lazy"
                                 src="@images[5].LegacyMediaFileAsset.Url"
                                 alt="@images[5].LegacyMediaFileTitle"
                                 class="gj-mosaic-img">
                        }
                    </div>
                    <div class="gj-cell gj-cell--g" data-lb>
                        @if (images.Count > 6)
                        {
                            <img loading="lazy"
                                 src="@images[6].LegacyMediaFileAsset.Url"
                                 alt="@images[6].LegacyMediaFileTitle"
                                 class="gj-mosaic-img">
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- LIGHTBOX OVERLAY — paste before closing -->
<div class="lb-overlay" id="lb" role="dialog" aria-modal="true" aria-label="Image viewer">
    <div class="lb-track-wrap">
        <div class="lb-frame">
            <div class="lb-strip" id="lb-strip">
            </div>
            <button class="lb-btn lb-btn--close" id="lb-close" aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </button>
            <button class="lb-btn lb-btn--prev" id="lb-prev" aria-label="Previous image">
                <i class="bi bi-arrow-left"></i>
            </button>
            <button class="lb-btn lb-btn--next" id="lb-next" aria-label="Next image">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
        <p class="lb-caption" id="lb-caption"></p>
    </div>
</div>
