@namespace ETG.Web.Components.EmailBuilder.Widgets.AutoFeatureTour_2024
@using Microsoft.AspNetCore.Components
@using ETG.Web.Components.PageBuilder.Widgets.Products

<!-- ===== Auto Feature Tour (2024) Section START HERE ===== -->
@if (Model.Tour is { } tour)
{
    <table align="center" width="100%" border="0"
           cellspacing="0" cellpadding="0" bgcolor="#ffffff">
        <tbody>
            <tr>
                <td align="center" valign="top" style="padding:20px;">
                    <table align="center" width="380" border="0"
                           cellspacing="0" cellpadding="0"
                           class="em_wrapper"
                           style="width:380px;max-width:380px;margin:0 auto;border:1px solid #ededed;">
                        <tbody>
                            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                            {
                                <tr>
                                    <td align="center" valign="top"
                                        style="line-height:0;font-size:0;">
                                        <img src="@(Model.ImageUrl.Imgixify(760, 400))"
                                             alt="@Model.ImageAlt"
                                             width="380" border="0"
                                             style="display:block;width:100%;max-width:380px;height:auto;margin:0 auto;" />
                                    </td>
                                </tr>
                            }

                            <tr>
                                <td align="left" style="padding:16px 14px 24px;">
                                    <table width="100%" border="0"
                                           cellspacing="0" cellpadding="0">
                                        <tbody>
                                            <!-- Country, package code and optional promotion -->
                                            <tr>
                                                <td style="padding-bottom:12px;">
                                                    <table width="100%" border="0"
                                                           cellspacing="0" cellpadding="0">
                                                        <tbody>
                                                            <tr>
                                                                <td align="left" valign="middle"
                                                                    style="font-family:Arial,sans-serif;font-size:10px;line-height:16px;color:#333333;">
                                                                    <strong>@Model.CountryName</strong>
                                                                    <span style="color:#777777;">
                                                                        (PACKAGE CODE: @tour.TourCode)
                                                                    </span>
                                                                </td>

                                                                @if (!string.IsNullOrWhiteSpace(Model.PromotionName))
                                                                {
                                                                    <td align="right" valign="middle"
                                                                        style="padding-left:8px;">
                                                                        <table align="right" border="0"
                                                                               cellspacing="0" cellpadding="0">
                                                                            <tbody>
                                                                                <tr>
                                                                                    <td align="center"
                                                                                        bgcolor="#333333"
                                                                                        style="max-width:130px;background-color:#333333;border-radius:18px;padding:5px 10px;font-family:Arial,sans-serif;font-size:9px;line-height:12px;font-weight:bold;color:#ffffff;text-transform:uppercase;">
                                                                                        @Model.PromotionName
                                                                                    </td>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                    </td>
                                                                }
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>

                                            <tr>
                                                <td align="left"
                                                    style="font-family:Arial,sans-serif;font-size:20px;line-height:26px;font-weight:bold;color:#CA568E;padding-bottom:8px;">
                                                    @tour.Name
                                                </td>
                                            </tr>

                                            @if (!string.IsNullOrWhiteSpace(Model.DepartureCity) ||
                                                 !string.IsNullOrWhiteSpace(Model.DestinationCity))
                                            {
                                                <tr>
                                                    <td align="left"
                                                        style="font-family:Arial,sans-serif;font-size:10px;line-height:16px;color:#333333;text-transform:uppercase;padding-bottom:16px;">
                                                        @if (!string.IsNullOrWhiteSpace(Model.DepartureCity))
                                                        {
                                                            <span>Starts from @Model.DepartureCity</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(Model.DepartureCity) &&
                                                             !string.IsNullOrWhiteSpace(Model.DestinationCity))
                                                        {
                                                            <span> and </span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(Model.DestinationCity))
                                                        {
                                                            <span>ends in @Model.DestinationCity</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(tour.Description))
                                            {
                                                <tr>
                                                    <td align="left"
                                                        style="font-family:Arial,sans-serif;font-size:14px;line-height:20px;color:#333333;padding-bottom:18px;">
                                                        @tour.Description
                                                    </td>
                                                </tr>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(Model.CTALabel) &&
                                                 !string.IsNullOrWhiteSpace(tour.Path))
                                            {
                                                <tr>
                                                    <td align="left">
                                                        <table align="left" border="0"
                                                               cellspacing="0" cellpadding="0">
                                                            <tbody>
                                                                <tr>
                                                                    <td align="center" bgcolor="#CA568E"
                                                                        style="border-radius:24px;padding:10px 16px;">
                                                                        <a href="@tour.Path" target="_blank"
                                                                           style="font-family:Arial,sans-serif;font-size:11px;line-height:16px;font-weight:bold;color:#ffffff;text-decoration:none;text-transform:uppercase;">
                                                                            @Model.CTALabel
                                                                        </a>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <table width="100%" border="0"
                                           cellspacing="0" cellpadding="0">
                                        <tbody>
                                            <tr>
                                                <td width="50%" align="left" valign="middle"
                                                    bgcolor="#ededed"
                                                    style="width:50%;padding:14px;font-family:Arial,sans-serif;color:#333333;">
                                                    <table width="100%" border="0"
                                                           cellspacing="0" cellpadding="0">
                                                        <tbody>
                                                            <tr>
                                                                <td align="left"
                                                                    style="font-size:14px;line-height:20px;font-weight:bold;">
                                                                    @tour.DaysFromLabel
                                                                </td>
                                                            </tr>

                                                            @if (tour.InclusionIcons is { Count: > 0 })
                                                            {
                                                                <tr>
                                                                    <td align="left"
                                                                        style="font-size:10px;line-height:16px;padding-top:6px;">
                                                                        @foreach (var icon in tour.InclusionIcons)
                                                                        {
                                                                            @if (icon is not null)
                                                                            {
                                                                                <span style="padding-right:6px;">@icon.Label</span>
                                                                            }
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(Model.SavingsMessage))
                                                            {
                                                                <tr>
                                                                    <td align="left" style="padding-top:8px;">
                                                                        <table border="0"
                                                                               cellspacing="0" cellpadding="0">
                                                                            <tbody>
                                                                                <tr>
                                                                                    <td bgcolor="#CA568E"
                                                                                        style="border-radius:16px;padding:4px 10px;font-size:10px;line-height:14px;color:#ffffff;">
                                                                                        @Model.SavingsMessage
                                                                                    </td>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </td>

                                                <td width="50%" align="right" valign="middle"
                                                    bgcolor="#CA568E"
                                                    style="width:50%;padding:14px;font-family:Arial,sans-serif;color:#ffffff;">
                                                    @if (!string.IsNullOrWhiteSpace(tour.CurrentPrice))
                                                    {
                                                        <table width="100%" border="0"
                                                               cellspacing="0" cellpadding="0">
                                                            <tbody>
                                                                <tr>
                                                                    <td align="right"
                                                                        style="font-size:10px;line-height:16px;color:#ffffff;">
                                                                        From
                                                                        @if (!string.IsNullOrWhiteSpace(tour.OriginalPrice))
                                                                        {
                                                                            <del>@tour.Currency @tour.OriginalPrice</del>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td align="right"
                                                                        style="font-size:26px;line-height:30px;font-weight:bold;color:#ffffff;">
                                                                        <span style="font-size:10px;">@tour.Currency</span>
                                                                        @tour.CurrentPrice
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td align="right"
                                                                        style="font-size:10px;line-height:14px;color:#ffffff;">
                                                                        @tour.PriceTypeLabel
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    }
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            @if (!string.IsNullOrWhiteSpace(Model.TimerUrl))
                            {
                                <tr>
                                    <td align="center" style="padding:12px;">
                                        <img src="@Model.TimerUrl"
                                             alt="Offer countdown"
                                             width="354" border="0"
                                             style="display:block;width:100%;max-width:354px;height:auto;margin:0 auto;" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
}
<!-- ===== // Auto Feature Tour (2024) Section END HERE ===== -->