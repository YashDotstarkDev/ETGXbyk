@namespace ETG.Web.Components.EmailBuilder.Widgets.Tour
@using Microsoft.AspNetCore.Components

@* Suppress Razor HTML validation for email templates *@
@* Email HTML has different rules than web HTML *@


<!-- == Tours Section == -->
<table bgcolor="#ffffff" width="100%" border="0" cellspacing="0" cellpadding="0" class="em_full_wrap" style="table-layout:fixed; background-color:#ffffff;">
  <tr>
    <td align="center" valign="top">
      <table align="center" width="600" border="0" cellspacing="0" cellpadding="0" class="em_main_table" style="width:600px; table-layout:fixed;">
        <tr>
          <td class="em_pad" align="center" valign="top">
            <table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
              <!-- == 2column Section1 == -->
                <tr>
                  <td class="em_defaultlink em_p15"  align="left" valign="top" style="font-size:20px; line-height:28px;  font-family: Arial, sans-serif; color:#CA568E; letter-spacing: 0.5px;  padding-bottom:6px; ">@Model.tourname</td>
                </tr>
                <tr>
                  <td align="left" valign="top" style="padding-bottom:6px;"><table width="165" align="left" border="0" cellspacing="0" cellpadding="0" style="width:165px;">
                    <tr>
                      <td align="left" valign="middle" style="font-size:14px; line-height:17px;  font-family: Arial, sans-serif; color:#333;">@Model.nights nights</td>
                      <td align="left" valign="top" width="9" style="width:9px; font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/spacer.gif" alt="" border="0" height="1" width="1" style="display:block;"/></td>
                      <td align="left" valign="top" style="font-size:14px; line-height:17px;  font-family: Arial, sans-serif; color:#333;">|</td>
                      @if ((Model.inclusions ?? string.Empty).Contains("Flights"))
                      {
                      <td align="left" valign="top" width="9" style="width:9px; font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/spacer.gif" alt="" border="0" height="1" width="1" style="display:block;"/></td>
                      <td align="center" valign="middle" style="font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/icon5.png" alt="" border="0" width="15" style="max-width:15px; display:block;"/></td>
                      }
                      @if ((Model.inclusions ?? string.Empty).Contains("Accommodation"))
                      {
                      <td align="left" valign="top" width="9" style="width:9px; font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/spacer.gif" alt="" border="0" height="1" width="1" style="display:block;"/></td>
                      <td align="center" valign="middle" style="font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/icon6.png" alt="" border="0" width="16" style="max-width:16px; display:block;"/></td>
                      }
                      @if ((Model.inclusions ?? string.Empty).Contains("Meals"))
                      {
                      <td align="left" valign="top" width="9" style="width:9px; font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/spacer.gif" alt="" border="0" height="1" width="1" style="display:block;"/></td>
                      <td align="center" valign="middle" style="font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/icon7.png" alt="" border="0" width="11" style="max-width:11px; display:block;"/></td>
                      }
                      @if ((Model.inclusions ?? string.Empty).Contains("Transfer"))
                      {
                      <td align="left" valign="top" width="9" style="width:9px; font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/spacer.gif" alt="" border="0" height="1" width="1" style="display:block;"/></td>
                      <td align="center" valign="middle" style="font-size:0px; line-height:0px;"><img src="https://www.entiretravel.com.au/edm/images/icon8.png" alt="" border="0" width="13" style="max-width:13px; display:block;"/></td>
                      }
                  </tr>
                  </table></td>
                </tr>
                <tr>
                  <td class="em_defaultlink" align="left" valign="top" style="font-size:14px; line-height:25px;  font-family: Arial, sans-serif; color:#929497; ">From <span style="color:#333333; font-weight:bold;">@Model.price per person</span></td>
                </tr>
                <tr>
                  <td class="em_defaultlink em_pbottom" align="left" valign="top" style="font-size:14px; line-height:25px;  font-family: Arial, sans-serif; color:#929497; padding-bottom:13px;">@Model.departure</td>
                </tr>
                <tr>
                  <td class="em_pbottom" align="center" valign="top" style="padding-bottom:45px;"><table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                      <td align="left" valign="top"><table align="left" class="em_wrapper" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                          <td align="center" valign="top"><img class="em_full_img1" src="@Model.image" alt="" border="0" width="291" style="max-width:291px; display:block; font-size:16px; line-height:20px; font-weight:bold; color:#000000; font-family:Arial,sans-serif;"/></td>
                        </tr>
                        </table>
                        
                        <!--[if gte mso 9]>
</td>
<td valign="top">
<![endif]-->
                        
                        <table align="right" width="289" class="em_wrapper" border="0" cellspacing="0" cellpadding="0" style="width:289px;">
                          <tr>
                            <td align="center" valign="top" class="em_ptop"><table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                              <tr>
                                <td class="em_defaultlink em_pbottom" align="left" valign="top" style="font-size:14px; line-height:25px;  font-family: Arial, sans-serif; color:#333333; padding-bottom:11px;">@((MarkupString)Model.copy)</td>
                              </tr>
                              @if (!string.IsNullOrWhiteSpace(Model.enquireUrl))
                              {
                              <tr>
                                <td  align="left" valign="top"><table align="left" class="em_wrapper" border="0" cellspacing="0" cellpadding="0">
                                  <tr>
                                    <td align="center" valign="top"><table align="center"  border="0" cellspacing="0" cellpadding="0">
                                      <tr>
                                        <td align="center" valign="middle" height="40" style="height:40px; font-size:14px; color:#CA568E; font-family:Arial, sans-serif; text-transform:uppercase; padding:0px 40px; font-weight:600; letter-spacing: 0.5px; border-radius:30px; border:2px solid #ca568e; display:block; "><a href="@Model.enquireUrl" target="_blank" style="text-decoration:none; color:#CA568E; display:block; line-height:40px;">Enquire</a></td>
                                      </tr>
                                      </table></td>
                                  </tr>
                                  </table></td>
                              </tr>
                              }
                              </table></td>
                          </tr>
                        </table></td>
                  </tr>
                  </table></td>
                </tr>
                <!-- == //2column Section1 == --> 
            </table>
          </td>
          </tr>
      </table>
    </td>
  </tr>
</table>
<!-- == //Tours Section == -->