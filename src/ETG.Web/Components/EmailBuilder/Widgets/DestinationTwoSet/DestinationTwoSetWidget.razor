@namespace ETG.Web.Components.EmailBuilder.Widgets.DestinationTwoSet
@using Microsoft.AspNetCore.Components

<!-- == Explore Destination Section == -->
<table bgcolor="#ffffff" width="100%" border="0" cellspacing="0" cellpadding="0" class="em_full_wrap" style="table-layout:fixed; background-color:#ffffff;">
    <tr>
        <td align="center" valign="top">
            <table align="center" width="600" border="0" cellspacing="0" cellpadding="0" class="em_main_table" style="width:600px; table-layout:fixed;">
                <tr>
                    <td class="em_pad" align="center" valign="top">
                        <table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td class="em_pbottom" align="left" valign="top" style="padding-bottom:20px;">
                                    <table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td>
                                                <!-- Left Column / Item 1 -->
                                                <table align="left" width="290" class="em_wrapper" border="0" cellspacing="0" cellpadding="0" style="width:290px;">
                                                    <tr>
                                                        <td align="center" valign="top">
                                                            <table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                                                                <tr>
                                                                    <td align="center" valign="top">
                                                                        <a href="@(string.IsNullOrWhiteSpace(Model.Url1) ? "#" : Model.Url1)" target="_blank" style="display:block; text-decoration: none;">
                                                                            @if (!string.IsNullOrWhiteSpace(Model.Image1Url))
                                                                            {
                                                                                <img class="em_full_img1" src="@Model.Image1Url" alt="@Model.Label1" border="0" width="290" style="max-width:290px; display:block; font-size:16px; line-height:20px; font-weight:bold; color:#000000; font-family:Arial,sans-serif;" />
                                                                            }
                                                                        </a>
                                                                    </td>
                                                                </tr>
                                                                @if (!string.IsNullOrWhiteSpace(Model.Label1))
                                                                {
                                                                    <tr>
                                                                        <td class="em_pad1" align="left" valign="top" bgcolor="#ededed" style="background-color:#ededed; padding:13px 20px; font-size:20px; line-height:28px; font-family: Arial, sans-serif; color:#CA568E; letter-spacing: 0.5px;">
                                                                            <a href="@(string.IsNullOrWhiteSpace(Model.Url1) ? "#" : Model.Url1)" target="_blank" style="display:block; text-decoration: none; color:#CA568E;">@Model.Label1</a>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </table>

                                                <!--[if gte mso 9]>
                                                </td>
                                                <td valign="top">
                                                <![endif]-->
                                                <!-- Right Column / Item 2 -->
                                                <table align="right" width="290" class="em_wrapper" border="0" cellspacing="0" cellpadding="0" style="width:290px;">
                                                    <tr>
                                                        <td align="center" valign="top" class="em_ptop">
                                                            <a href="@(string.IsNullOrWhiteSpace(Model.Url2) ? "#" : Model.Url2)" target="_blank" style="display:block; text-decoration: none;">
                                                                <table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                                                                    @if (!string.IsNullOrWhiteSpace(Model.Image2Url))
                                                                    {
                                                                        <tr>
                                                                            <td align="center" valign="top">
                                                                                <img class="em_full_img1" src="@Model.Image2Url" alt="@Model.Label2" border="0" width="290" style="max-width:290px; display:block; font-size:16px; line-height:20px; font-weight:bold; color:#000000; font-family:Arial,sans-serif;" />
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(Model.Label2))
                                                                    {
                                                                        <tr>
                                                                            <td class="em_pad1" align="left" valign="top" bgcolor="#ededed" style="background-color:#ededed; padding:13px 20px; font-size:20px; line-height:28px; font-family: Arial, sans-serif; color:#CA568E; letter-spacing: 0.5px;">
                                                                                @Model.Label2
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </table>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
<!-- == //Explore Destination Section == -->