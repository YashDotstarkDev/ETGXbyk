@using Kentico.EmailBuilder.Web.Mvc
@using Kentico.VisualBuilderComponents.Rcl.Components
@using ETG

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:v="urn:schemas-microsoft-com:vml"
      xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <!--[if gte mso 9]>
    <xml>
        <o:OfficeDocumentSettings>
            <o:AllowPNG/>
            <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->
    <title>Entire Travel Agents - Entire Travel Group</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />

    <EmailBuilderStyles />

    <style type="text/css">
            body {
                margin: 0;
                padding: 0;
                -webkit-text-size-adjust: 100% !important;
                -ms-text-size-adjust: 100% !important;
                -webkit-font-smoothing: antialiased !important;
            }

            img {
                border: 0 !important;
                outline: none !important;
            }

            p {
                Margin: 0px !important;
                Padding: 0px !important;
            }

            table {
                border-collapse: collapse;
                mso-table-lspace: 0px;
                mso-table-rspace: 0px;
            }

            td, a, span {
                border-collapse: collapse;
                mso-line-height-rule: exactly;
            }

            .ExternalClass * {
                line-height: 100%;
            }

            .em_defaultlink a {
                color: inherit;
                text-decoration: none;
            }

            .em_g_img + div {
                display: none;
            }

            a[x-apple-data-detectors], u + .em_body a, #MessageViewBody a {
                color: inherit;
                text-decoration: none;
                font-size: inherit !important;
                font-family: inherit !important;
                font-weight: inherit !important;
                line-height: inherit;
            }

            @@media only screen and (max-width:599px) {
                .em_main_table {
                    width: 100% !important;
                }

                .em_wrapper {
                    width: 100% !important;
                }

                .em_hide {
                    display: none !important;
                }

                .em_full_img img {
                    width: 100% !important;
                    height: auto !important;
                }

                .em_full_img {
                    width: 100% !important;
                    height: auto !important;
                }

                .em_full_img1 {
                    width: 100% !important;
                    height: auto !important;
                    max-width: none !important;
                }

                .em_side15 {
                    width: 15px !important;
                }

                .em_aside15 {
                    padding: 0px 15px !important;
                }

                .em_ptop {
                    padding-top: 20px !important;
                }

                .em_pbottom {
                    padding-bottom: 20px !important;
                }

                u + .em_body .em_full_wrap {
                    width: 100% !important;
                    width: 100vw !important;
                }

                .em_pad {
                    padding: 20px 15px !important;
                }

                .em_pad1 {
                    padding: 10px 15px !important;
                }

                .em_p15 {
                    padding-bottom: 10px !important;
                }

                .em_p1 {
                    padding: 0px 15px 8px !important;
                }
            }

            @@media screen and (max-width:480px) {
                .em_font20 {
                    font-size: 20px !important;
                    line-height: 24px !important;
                }

                .em_font18 {
                    font-size: 17px !important;
                    line-height: 24px !important;
                }

                .em_text1 {
                    font-size: 18px !important;
                    line-height: 24px !important;
                }
            }
    </style>
</head>

<body bgcolor="#ffffff" class="em_body" style="margin:0px auto; padding:0px; background-color:#ffffff;">
    <span style="display:none">@(Model?.Preheader ?? Model?.EmailPreviewText)</span>

    <!-- Header Section -->
    <table bgcolor="#ffffff" width="100%" border="0" cellspacing="0" cellpadding="0" class="em_full_wrap" style="table-layout:fixed; background-color:#ffffff;">
        <tr>
            <td align="center" valign="top">
                <table align="center" width="600" border="0" cellspacing="0" cellpadding="0" class="em_main_table" style="width:600px; table-layout:fixed;">
                    <tr>
                        <td class="em_pad" align="center" valign="top" style="padding:30px 0px 30px;">
                            <table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td align="left" valign="top">
                                        <table align="left" class="em_wrapper" border="0" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td align="center" valign="top">
                                                    <a href="https://www.entiretravel.com.au/" target="_blank" style="text-decoration:none;">
                                                        <img src="https://www.entiretravel.com.au/edm/images/etg.png" alt="ENTIRE TRAVEL GROUP" border="0" width="121" style="max-width:121px; display:block; font-size:16px; line-height:20px; font-weight:bold; color:#000000; font-family:Arial,sans-serif;" />
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>

                                        @((MarkupString)"<!--[if gte mso 9]></td><td valign=\"top\"><![endif]-->")

                                        <table align="right" class="em_wrapper" border="0" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td class="em_defaultlink" align="center" valign="top" style="padding-top:15px; font-family:Arial,sans-serif; font-size:16px; line-height:20px; color:#333333; letter-spacing:0.5px; text-transform:uppercase; font-weight:600;"></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Subscription confirmation -->
    You have been subscribed.

    <!-- Travel specialists Section -->
    <table bgcolor="#ca568e" width="100%" border="0" cellspacing="0" cellpadding="0" class="em_full_wrap" style="background-color:#ca568e;">
        <tr>
            <td align="center" valign="top">
                <table align="center" width="600" border="0" cellspacing="0" cellpadding="0" class="em_main_table" style="width:600px; table-layout:fixed;">
                    <tr>
                        <td class="em_pad" align="center" valign="top" style="padding:50px 0px 47px;">
                            <table align="left" class="em_wrapper" width="540" border="0" cellspacing="0" cellpadding="0" style="width:540px;">
                                <tr>
                                    <td align="left" valign="top">
                                        <table align="left" width="300" class="em_wrapper" border="0" cellspacing="0" cellpadding="0" style="width:300px;">
                                            <tr>
                                                <td align="left" valign="top" style="font-size:20px; line-height:28px; font-family:Arial,sans-serif; color:#ffffff; letter-spacing:0.5px; font-weight:600; text-transform:uppercase;">
                                                    Our travel specialists <br class="em_hide" />
                                                    would love to&nbsp;help!
                                                </td>
                                            </tr>
                                        </table>

                                        @((MarkupString)"<!--[if gte mso 9]></td><td valign=\"top\"><![endif]-->")

                                        <table align="right" width="205" class="em_wrapper" border="0" cellspacing="0" cellpadding="0" style="width:205px;">
                                            <tr>
                                                <td align="left" valign="top" class="em_ptop">
                                                    <table align="left" border="0" cellspacing="0" cellpadding="0">
                                                        <tr>
                                                            <td align="left" valign="top" style="padding-bottom:8px; font-size:0px; line-height:0px;">
                                                                <table align="left" border="0" cellspacing="0" cellpadding="0">
                                                                    <tr>
                                                                        <td align="left" valign="middle" width="23" style="font-size:0px; line-height:0px; width:23px;">
                                                                            <img src="https://www.entiretravel.com.au/edm/images/clock.png" alt="" border="0" width="14" style="max-width:14px; display:block;" />
                                                                        </td>
                                                                        <td class="em_defaultlink" align="left" valign="middle" style="font-size:14px; line-height:17px; font-family:Arial,sans-serif; color:#ffffff;">
                                                                            9am&nbsp; - 5:30pm, Mon to Fri
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <td align="left" valign="top" style="padding-bottom:8px; font-size:0px; line-height:0px;">
                                                                <table align="left" border="0" cellspacing="0" cellpadding="0">
                                                                    <tr>
                                                                        <td align="left" valign="middle" width="23" style="font-size:0px; line-height:0px; width:23px;">
                                                                            <a href="tel:+61290943322" style="text-decoration:none; color:#ffffff;">
                                                                                <img src="https://www.entiretravel.com.au/edm/images/phone.png" alt="" border="0" width="14" style="max-width:14px; display:block;" />
                                                                            </a>
                                                                        </td>
                                                                        <td class="em_defaultlink" align="left" valign="middle" style="font-size:14px; line-height:17px; font-family:Arial,sans-serif; color:#ffffff;">
                                                                            <a href="tel:+61290943322" style="text-decoration:none; color:#ffffff;">+61 2 9094 3322</a>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <td align="left" valign="top" style="font-size:0px; line-height:0px;">
                                                                <table align="left" border="0" cellspacing="0" cellpadding="0">
                                                                    <tr>
                                                                        <td align="left" valign="middle" width="23" style="font-size:0px; line-height:0px; width:23px;">
                                                                            <a href="mailto:info@entiretravel.com.au" style="text-decoration:none; color:#ffffff;">
                                                                                <img src="https://www.entiretravel.com.au/edm/images/envelope.png" alt="" border="0" width="14" style="max-width:14px; display:block;" />
                                                                            </a>
                                                                        </td>
                                                                        <td class="em_defaultlink" align="left" valign="middle" style="font-size:14px; line-height:17px; font-family:Arial,sans-serif; color:#ffffff;">
                                                                            <a href="mailto:info@entiretravel.com.au" style="text-decoration:none; color:#ffffff;">info@entiretravel.com.au</a>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Footer Section -->
    <table bgcolor="#ededed" width="100%" border="0" cellspacing="0" cellpadding="0" class="em_full_wrap" style="background-color:#ededed;">
        <tr>
            <td align="center" valign="top">
                <table align="center" width="600" border="0" cellspacing="0" cellpadding="0" class="em_main_table" style="width:600px; table-layout:fixed;">
                    <tr>
                        <td class="em_pad" align="center" valign="top" style="padding:30px 15px 50px;">
                            <table align="center" width="100%" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td class="em_pbottom" align="center" valign="top" style="padding-bottom:16px;">
                                        <table align="center" border="0" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td align="center" style="padding-right:25px; font-size:0px; line-height:0px;" valign="middle">
                                                    <a href="https://www.facebook.com/entiretravelgroup/" style="text-decoration:none; color:#000000;" target="_blank">
                                                        <img alt="fb" border="0" src="https://www.entiretravel.com.au/edm/images/Social_icon1.png" style="max-width:11px; display:block; font-size:13px; line-height:16px; color:#000000; font-weight:bold; font-family:Arial,sans-serif;" width="11" />
                                                    </a>
                                                </td>
                                                <td align="center" style="padding-right:25px; font-size:0px; line-height:0px;" valign="middle">
                                                    <a href="https://www.instagram.com/entiretravelgroup/" style="text-decoration:none; color:#000000;" target="_blank">
                                                        <img alt="insta" border="0" src="https://www.entiretravel.com.au/edm/images/Social_icon2.png" style="max-width:18px; display:block; font-size:13px; line-height:16px; color:#000000; font-weight:bold; font-family:Arial,sans-serif;" width="18" />
                                                    </a>
                                                </td>
                                                <td align="center" style="font-size:0px; line-height:0px;" valign="middle">
                                                    <a href="https://au.linkedin.com/company/entire-travel-group" style="text-decoration:none; color:#000000;" target="_blank">
                                                        <img alt="in" border="0" src="https://www.entiretravel.com.au/edm/images/Social_icon3.png" style="max-width:18px; display:block; font-size:13px; line-height:16px; color:#000000; font-weight:bold; font-family:Arial,sans-serif;" width="18" />
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td align="center" valign="top" style="font-size:14px; line-height:22px; color:#333333; font-family:Arial,sans-serif; padding-bottom:10px;">
                                        You are receiving this email because
                                        <a href="mailto:{{Recipient.Email}}" style="text-decoration:none; color:#333333;">{{Recipient.Email}}</a>
                                        is signed up to receive Entire Travel Group communications.
                                        If you prefer not to receive emails from us, please&nbsp;
                                        <a href="@(Model?.UnsubscribeFromEmailFeedUrl)" target="_blank" style="text-decoration:none; color:#CA568E;">unsubscribe</a>.
                                    </td>
                                </tr>

                                <tr>
                                    <td align="center" style="font-size:14px; line-height:22px; color:#CA568E; font-family:Arial,sans-serif; padding-bottom:11px;" valign="top">
                                        <a href="https://www.entiretravel.com.au/about-us" style="text-decoration:none; color:#CA568E; white-space:nowrap;" target="_blank">Who we are</a>
                                        <span style="color:#333333;">&nbsp;|&nbsp;</span>
                                        <a href="https://www.entiretravel.com.au/contact-us" style="text-decoration:none; color:#CA568E; white-space:nowrap;" target="_blank">Contact us</a>
                                        <span style="color:#333333;">&nbsp;|&nbsp;</span>
                                        <a href="https://www.entiretravel.com.au/legals/privacy-policy" style="text-decoration:none; color:#CA568E; white-space:nowrap;" target="_blank">Privacy policy</a>
                                    </td>
                                </tr>

                                <tr>
                                    <td align="center" valign="top" style="font-size:14px; line-height:22px; color:#333333; font-family:Arial,sans-serif; padding-bottom:7px;">
                                        To ensure that you receive your Entire Travel Group emails, please add
                                        <a href="mailto:marketing@entiretravel.com.au" style="text-decoration:none; color:#CA568E;">marketing@entiretravel.com.au</a>
                                        to your address&nbsp;book.
                                    </td>
                                </tr>

                                <tr>
                                    <td align="center" valign="top" style="font-size:12px; line-height:22px; color:#929497; font-family:Arial,sans-serif; padding-bottom:10px;">
                                        Entire Travel Group | 803/83 Mount Street, North&nbsp;Sydney&nbsp;NSW <br class="em_hide" />
                                        &copy; 2020 Entire Travel Group, Pty. All&nbsp;rights&nbsp;reserved.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td class="em_hide" style="line-height:1px; min-width:600px; background-color:#ffffff;">
                            <img alt="" src="https://www.entiretravel.com.au/edm/images/spacer.gif" height="1" width="600" style="max-height:1px; min-height:1px; display:block; width:600px; min-width:600px;" border="0" />
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <EmailBuilderScripts />
</body>
</html>