@using System.Linq
@using ETG.Web.Features.TravelType
@using Kentico.PageBuilder.Web.Mvc.PageTemplates
@model TravelTypeDetailPageViewModel

@{
    var viewModel = Model;
}

    <vc:bread-crumb />
    @await Html.PartialAsync(
    "~/Views/Shared/Partial/Common/_Hero.cshtml",
    viewModel.Hero
    )
    <div class="container">
        <div class="row">
        <div class="col-lg-10" style="margin-top: 30px;">
                <div class="title-div">
                    <h2 id="tahiti-info-title" class="section-title">

                        @viewModel.Heading
                    </h2>
                </div>

                @if (!string.IsNullOrWhiteSpace(viewModel.Summary))
            {
                <p class="text-muted" style="line-height:1.8;">
                    @viewModel.Summary
                </p>
            }
            </div>
        </div>
    </div>

    <editable-area area-identifier="Zone1" />
    <editable-area area-identifier="Zone2" />

@if (Model.ContactUs is not null)
{
    <partial name="~/Views/Shared/Partial/Common/_ContactUs.cshtml"
             model="Model.ContactUs" />
}

    @if (viewModel.RelatedArticles?.Any() == true)
{
    <div class="spacer"></div>

    @await Html.PartialAsync(
        "~/Views/Shared/Partial/Article/RelatedArticlePartial.cshtml",
        viewModel.RelatedArticles
    )
}

@{
    var sticky = Model.TravelTypeStickyModel;
}

@if (sticky is not null && sticky.DisplaySticky
    && (!string.IsNullOrWhiteSpace(sticky.CampaignDetail1)
        || !string.IsNullOrWhiteSpace(sticky.CampaignDetail2)
        || !string.IsNullOrWhiteSpace(sticky.CampaignDetail3)))
{
    <partial name="~/Views/Shared/Partial/Common/_CampaignStickyBar.cshtml"
             model="sticky" />
}

