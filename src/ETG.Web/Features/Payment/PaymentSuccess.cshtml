@model ETG.Web.Features.Payment.PaymentPageViewModel

@{
    ViewData["Title"] = "Payment Confirmation";
}

@if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
{
    <div class="position-relative overflow-hidden mb-4" style="max-height: 340px; background-color: #2d3748;">
        <img src="@Model.HeroImageUrl.Imgixify(1920, 480)" 
             srcset="@Model.HeroImageUrl.ImgixSrcset(1920, 480, new[] { 1 })"
             width="1920"
             height="480"
             alt="@(Model.HeroImage?.LegacyMediaFileTitle ?? "Payment Confirmation")" 
             class="w-100 h-100 object-fit-cover" 
             style="min-height: 200px; max-height: 340px;" />
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0, 0, 0, 0.45);">
            <h1 class="about-hero-title text-white fw-bold display-4">Payment <span class="text-pink">Confirmation</span> </h1>
        </div>
    </div>
}

<div class="container py-5 my-2">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center">
                <div class="mb-4">
                    <i class="fa-solid fa-circle-check text-success" style="font-size: 4rem;"></i>
                </div>

                <h1 class="h2 fw-bold text-dark mb-3">Payment Successful</h1>

                @if (!string.IsNullOrWhiteSpace(Model.ThankYouCopy))
                {
                    <div class="lead text-secondary mb-4 text-start bg-light p-4 rounded-3 border">
                        @Html.Raw(Model.ThankYouCopy)
                    </div>
                }
                else
                {
                    <p class="lead text-secondary mb-4">
                        Thank you for your payment. Your transaction has been securely processed by our payment provider, <strong>TravelPay</strong>.
                    </p>
                }

                @if (Model.Payment != null)
                {
                    <div class="table-responsive text-start mb-4">
                        <table class="table table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th class="bg-light text-muted w-40">Amount Paid</th>
                                    <td class="fw-bold text-success fs-5">$@Model.Payment.PaymentAmountPaid.ToString("F2") AUD</td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">Invoice Booking Reference</th>
                                    <td class="fw-semibold">@Model.Payment.PaymentInvoiceReference</td>
                                </tr>
                                @if (!string.IsNullOrWhiteSpace(Model.Payment.PaymentReference))
                                {
                                    <tr>
                                        <th class="bg-light text-muted">TravelPay Transaction ID</th>
                                        <td class="font-monospace">@Model.Payment.PaymentReference</td>
                                    </tr>
                                }
                                <tr>
                                    <th class="bg-light text-muted">Customer Name</th>
                                    <td>@Model.Payment.PaymentFirstName @Model.Payment.PaymentLastName</td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">Payment Date</th>
                                    <td>@Model.Payment.PaymentLastModified.ToString("dd MMM yyyy, hh:mm tt")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3 mt-3 flex-wrap">
                    <button onclick="window.print()" class="btn btn-outline-secondary px-4 py-2">
                        <i class="fa-solid fa-print me-2"></i>Print Receipt
                    </button>
                    <a href="/" class="btn btn-primary px-4 py-2" style="background-color: #ca568e; border-color: #ca568e;">
                        <i class="fa-solid fa-house me-2"></i>Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
