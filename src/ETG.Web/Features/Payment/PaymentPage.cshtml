@model ETG.Web.Features.Payment.PaymentPageViewModel

@{
    ViewData["Title"] = Model.Heading ?? "Client Payments";
}

<!-- Top Hero Banner (Kentico 13 Style) -->
<div class="payment-hero-banner py-4 " style="background-color: #ededed; border-bottom: 1px solid #e2e8f0;">
    <div class="container">
        <h1 class="fw-bold mb-0 text-dark" style="font-size: 3.2rem; font-family: Lato, Arial, sans-serif;">
            @(string.IsNullOrWhiteSpace(Model.Heading) ? "Client Payments" : Model.Heading)
        </h1>
    </div>
</div>

<div class="container py-4 payment-page-container">
    <!-- Intro / Lead Text -->
    <div class="mb-4 text-secondary payment-lead-text" style="font-size: 1.05rem; line-height: 1.6; max-width: 820px; padding:20px;">
        @if (!string.IsNullOrWhiteSpace(Model.PaymentPageContent))
        {
            @Html.Raw(Model.PaymentPageContent)
        }
        else
        {
            <p class="mb-0">
                To pay by credit card, please complete the form below.<br />
                The credit card transaction is in AUD.
            </p>
        }
    </div>

    <div class="row g-4">
        <!-- Main Form Column (Left) -->
        <div class="col-lg-8">
            <div class="payment-card-box">
                <div class="form-heading-wrapper">
                    <h3>Your details</h3>
                    <div class="cards-badge">
                        <img src="~/images/cards-new.png" 
                             alt="Accepted cards: Visa, MasterCard, American Express, Diners Club" 
                             class="cards-badge-img" />
                    </div>
                </div>

                <div id="payment-error-banner" class="alert alert-danger d-none" role="alert"></div>

                <form id="client-payment-form" novalidate>
                    <!-- Row 1: First Name (Left) | Email (Right) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="payment-firstname" class="form-label">Lead passenger - First name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="payment-firstname" required />
                            <div class="invalid-feedback">Please enter first name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="payment-email" class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="payment-email" required />
                            <div class="invalid-feedback">Please enter a valid email address.</div>
                        </div>
                    </div>

                    <!-- Row 2: Last Name (Left) | Invoice Reference (Right) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="payment-lastname" class="form-label">Lead passenger - Last name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="payment-lastname" required />
                            <div class="invalid-feedback">Please enter last name.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="payment-invoiceref" class="form-label d-flex align-items-center">
                                Invoice Booking Reference <span class="text-danger">*</span>
                                <i class="fa-solid fa-circle-question info-tooltip-icon ms-2" 
                                   data-bs-toggle="tooltip" 
                                   data-bs-html="true"
                                   data-bs-placement="top" 
                                   title="Use the full alpha-numeric Booking Reference shown on your invoice.<br><br>e.g. <b>ETG123456</b>"></i>
                            </label>
                            <input type="text" class="form-control" id="payment-invoiceref" required />
                            <div class="invalid-feedback">Please enter the invoice booking reference.</div>
                        </div>
                    </div>

                    <!-- Row 3: Contact Number (Left) | Amount (Right) -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="payment-phone" class="form-label d-flex align-items-center">
                                Contact number
                                <i class="fa-solid fa-circle-question info-tooltip-icon ms-2"
                                   data-bs-toggle="tooltip"
                                   data-bs-html="true"
                                   data-bs-placement="top"
                                   title="<b>Australian Number</b><br><i>Area Code + Number</i><br>e.g. 0290943322<br><br><b>Australian Mobile</b><br><i>10 digits no spaces</i><br>e.g. 0430123123<br><br><b>International Number</b><br><i>Country Code + area code + number</i><br>e.g. +33148643543"></i>
                            </label>
                            <input type="tel" class="form-control" id="payment-phone" />
                            <div class="invalid-feedback">Please enter contact number.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="payment-amount" class="form-label">Payment Amount <span class="text-danger">*</span></label>
                            <div class="currency-input-group">
                                <span class="currency-symbol-addon">$</span>
                                <input type="number" step="0.01" min="1" class="form-control" id="payment-amount" required />
                                <div class="invalid-feedback">Please enter the payment amount.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Terms and Conditions Checkbox -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="payment-accept-terms" required />
                        <label class="form-check-label" for="payment-accept-terms">
                            I accept the 
                            <a href="/booking-conditions" target="_blank" class="terms-conditions-link">Terms and Conditions <i class="fa-solid fa-arrow-up-right-from-square small"></i></a> 
                            and 
                            <a href="https://travelpay.com.au/travelpay-public-webpay-terms-conditions" target="_blank" class="terms-conditions-link">Payment Conditions <i class="fa-solid fa-arrow-up-right-from-square small"></i></a>.
                        </label>
                        <div class="invalid-feedback">Please accept Terms and Conditions.</div>
                    </div>

                    <!-- reCAPTCHA v3 Partial View -->
                    <partial name="~/Components/FormBuilder/ReCaptcha/ReCaptcha.cshtml"
                             view-data='@new ViewDataDictionary(ViewData) { { "ActionName", "client_payment_submit" }, { "TokenHiddenId", "paymentRecaptchaToken" }, { "ActionHiddenId", "paymentRecaptchaAction" }, { "DivId", "google-recaptcha-payment" } }' />

                    <!-- Centered PAY NOW Button -->
                    <div class="d-flex justify-content-center mt-4">
                        <button type="submit" id="btn-pay-now" class="btn btn-pay-now-pill">
                            <span class="btn-text">PAY NOW</span>
                            <span class="btn-spinner d-none"><i class="fa-solid fa-spinner fa-spin me-2"></i>Processing...</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sidebar Column (Right: Other payment options) -->
        <div class="col-lg-4">
            <div class="payment-sidebar-box shadow-sm">
                <h4>Other payment options</h4>

                @if (Model.PaymentOptions != null && Model.PaymentOptions.Any())
                {
                    @foreach (var option in Model.PaymentOptions)
                    {
                        <div class="other-option-item">
                            <div class="other-option-title">@option.Name</div>
                            <div class="other-option-desc">
                                @Html.Raw(option.Description)
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="other-option-item">
                        <div class="other-option-title">Direct Deposit</div>
                        <div class="other-option-desc">
                            Entire Travel Group Pty Ltd<br />
                            BSB : 082-401<br />
                            A/C : 71-846-1340
                        </div>
                    </div>
                    <div class="other-option-item">
                        <div class="other-option-title">Pay ID</div>
                        <div class="other-option-desc">
                            <a href="mailto:payments@entiretravel.com.au" style="color: #ca568e; text-decoration: none;">payments@entiretravel.com.au</a><br />
                            Entire Travel Group
                        </div>
                    </div>
                }

                <div class="sidebar-notice-box">
                    <div class="notice-heading">Note:</div>
                    Please ensure Invoice Booking Reference is used for payments.
                </div>
            </div>
        </div>
    </div>

    <!-- PageBuilder Editable Area for FAQ Widget (Matches Kentico 13 editableRHS) -->
    <div class="mt-4">
        @if (Model.HasWebPageContext)
        {
            <editable-area area-identifier="editableRHS" />
        }
    </div>
</div>


@section Scripts {
    @if (!string.IsNullOrWhiteSpace(Model.TravelpayBS5JSLink))
    {
        <script type="text/javascript" src="@Model.TravelpayBS5JSLink" defer></script>
    }
    else if (!string.IsNullOrWhiteSpace(Model.TravelpayJSLink))
    {
        <script type="text/javascript" src="@Model.TravelpayJSLink" defer></script>
    }

    <script src="~/js/client-payment.js" asp-append-version="true" defer></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Bootstrap tooltips with HTML enabled
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl, { html: true });
            });
        });
    </script>
}
