@model ETG.Web.Features.Errors.PageNotFoundViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Looks like you've lost your way";
}

<main class="bg-white">
    <!-- Top 404 Hero Section with Homepage Dropdown Form -->
    <section class="section-pad text-center position-relative" style="background-color: #ededed; z-index: 20;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10 col-xl-9">
                    <h1 class="error-title text-uppercase mb-2 display-4" style="letter-spacing: 0.5px;font-weight: 700;">Looks like you've
                        <span class="accent-italic"> lost your way</span>
                        </h1>
                        <div style="display:flex; align-items:center;justify-content:center">
                    <p class="text-muted mb-4" style="width:47rem;font-size:22px;">
                        Let us help get you back on track. Search a destination, experience or tour, or browse the content below for some inspiration.
                    </p>
                    </div>
                    <!-- Algolia Dropdown Search Form (Matching Homepage) -->
                    <form class="hero-search shadow-lg text-start"
                          role="search"
                          id="heroSearchForm"
                          data-from="404page"
                          data-app-id="@Model.SearchAppId"
                          data-api-key="@Model.SearchApiKey"
                          data-index-name="@Model.SearchIndexName">

                        <div class="row g-0 align-items-center">

                            <!-- 1. Destination (DYNAMIC from Algolia) -->
                            <div class="col-4 col-md-3 search-field">
                                <label class="form-label">Destination</label>

                                <select class="form-select tom-select"
                                        aria-label="Destination"
                                        id="heroDestination">
                                    <option value="all">Select</option>
                                </select>
                            </div>

                            <!-- 2. Experience (DYNAMIC from Algolia) -->
                            <div class="col-4 col-md-3 search-field">
                                <label class="form-label">Experience</label>

                                <select class="form-select tom-select"
                                        aria-label="Experience"
                                        id="heroExperience">
                                    <option value="all">Select</option>
                                </select>
                            </div>

                            <!-- 3. Keyword -->
                            <div class="col-4 col-md-3 search-field">
                                <label class="form-label">Keyword</label>

                                <input type="text"
                                       name="Keyword"
                                       id="heroKeyword"
                                       placeholder="Keyword"
                                       class="form-control">
                            </div>

                            <!-- 4. Button -->
                            <div class="col-12 col-md-3 d-grid mt-3 mt-md-0 text-center">
                                <button type="submit"
                                        class="btn btn-pink btn-lg search-btn">
                                    Find
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Tour Packages Listing (8 Recently Published Packages Ordered by Lowest Price) -->
    @if (Model.Tours != null && Model.Tours.Tours.Any())
    {
        <partial name="~/Views/Shared/Partial/Tour/_TourListing.cshtml" model="Model.Tours" />
    }

    <!-- Related Articles Section (Top 3 Recently Published Articles) -->
    @if (Model.Articles != null && Model.Articles.Any())
    {
        <section class="section-pad blogs-page-layout">
            <div class="container">
                <div class="d-flex justify-content-between align-items-end mb-4 title-div">
                    <h2 class="section-title">Read what we've written</h2>
                    <a href="/articles" class="view-all-btn">View All</a>
                </div>

                <partial name="~/Views/Shared/Partial/Article/RelatedArticlePartial.cshtml" model="Model.Articles" />
            </div>
        </section>
    }
</main>

@section Scripts
{
    <!-- Algolia External Scripts for Dropdown Search -->
    <script src="https://cdn.jsdelivr.net/npm/algoliasearch@4/dist/algoliasearch-lite.umd.js"></script>
    <script src="~/algolia/homepagescript.js" asp-append-version="true"></script>
}
