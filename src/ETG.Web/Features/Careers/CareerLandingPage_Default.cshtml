@using ETG.Web.Features.Career
@model CareerLandingPageViewModel

@{
    CareerLandingPageViewModel? viewModel = null;

    try
    {
        viewModel = Model;
    }
    catch (InvalidCastException)
    {
        return;
    }

    if (viewModel is null)
    {
        return;
    }
}
@if (!string.IsNullOrWhiteSpace(viewModel.JsonSchema))
{
    <script type="application/ld+json">
        @Html.Raw(viewModel.JsonSchema)
    </script>
}
<vc:bread-crumb />

@await Html.PartialAsync(
    "~/Views/Shared/Partial/Common/_Hero.cshtml",
    viewModel.Hero)

<section class="section-pad careers-intro bg-lightgray">
    <div class="container html-text">
        <div class="row">
            <div class="col-lg-12">
                @Html.Raw(viewModel.Content)

                <div class="careers-intro-buttons">
                    <a href="/careers/apply" class="btn btn-pink btn-lg">
                        SEND US YOUR CV
                    </a>
                    <a href="#vacancies"
                       class="btn about-link-pink view-all-btn">
                        VIEW OUR VACANCIES
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<editable-area area-identifier="Content" />
@if (viewModel.CareerRoles.Count > 0)
{
    <section class="section-pad careers-opportunities"
             id="vacancies"
             aria-labelledby="opportunities-title">
        <div class="container">
            <h2 id="opportunities-title"
                class="section-title text-start mb-4">
                Current Career Opportunities
            </h2>

            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="careers-job-list mt-3">
                        @foreach (var role in viewModel.CareerRoles)
                        {
                            <a href="@role.Path" class="careers-job-item">
                                <h3 class="careers-job-title">
                                    @role.Title
                                </h3>

                                <div class="careers-job-meta">
                                    <span class="careers-job-loc">
                                        @role.Location
                                    </span>
                                    <span class="careers-job-divider">|</span>
                                    <span class="careers-job-type">
                                        @role.PositionType
                                    </span>
                                    <span class="careers-job-arrow"></span>
                                </div>
                            </a>
                        }
                    </div>

                    <div class="careers-or-divider text-center">
                        <span>Or</span>
                    </div>

                    <div class="text-center" id="send-cv">
                        <a href="/careers/apply"
                           class="btn btn-pink btn-lg careers-send-btn">
                            SEND US YOUR CV
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

