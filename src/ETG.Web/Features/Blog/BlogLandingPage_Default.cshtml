@using ETG.Web.Features.Blog
@model TemplateViewModel<BlogLandingPageTemplateProperties>

@{
    var viewModel = Model.GetTemplateModel<BlogLandingPageViewModel>();
    var posts = viewModel?.BlogPosts ?? [];
    var categories = viewModel?.AllCategories ?? [];
    var selectedCategories = (viewModel?.SelectedCategories ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVJkEZSMUkrQ6usKICT5eTUIAxMsV361X7fjM+VUP+VlULksYbUjvL3+8zXMzpqKLI8UVmjsDKw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        .blog-landing-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 100px 0;
            text-align: center;
            margin-bottom: 60px;
        }

            .blog-landing-hero h1 {
                font-size: 3rem;
                font-weight: 700;
                margin-bottom: 20px;
            }

            .blog-landing-hero p {
                font-size: 1.2rem;
                opacity: 0.9;
                max-width: 600px;
                margin: 0 auto;
            }

        @@media (max-width: 768px) {
            .blog-landing-hero h1 {
                font-size: 2rem;
            }

            .blog-landing-hero p {
                font-size: 1rem;
            }
        }

        .blog-breadcrumb {
            background-color: #f8f9fa;
            padding: 12px 0;
            margin-bottom: 30px;
            font-size: 0.9rem;
        }

            .blog-breadcrumb .breadcrumb {
                margin: 0;
            }

            .blog-breadcrumb .breadcrumb-item {
                color: #6c757d;
            }

                .blog-breadcrumb .breadcrumb-item.active {
                    color: #495057;
                    font-weight: 500;
                }

            .blog-breadcrumb a {
                color: #667eea;
                text-decoration: none;
            }

                .blog-breadcrumb a:hover {
                    color: #764ba2;
                    text-decoration: underline;
                }

        .blog-container {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 40px;
            padding: 40px 0 60px;
        }

        @@media (max-width: 992px) {
            .blog-container {
                grid-template-columns: 250px 1fr;
                gap: 30px;
            }
        }

        @@media (max-width: 768px) {
            .blog-container {
                grid-template-columns: 1fr;
                gap: 30px;
            }
        }

        /* Left Sidebar Filters */
        .blog-sidebar {
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            height: fit-content;
            position: sticky;
            top: 20px;
        }

        .blog-filter-section {
            margin-bottom: 30px;
        }

            .blog-filter-section:last-child {
                margin-bottom: 0;
            }

        .blog-filter-title {
            font-weight: 700;
            margin-bottom: 15px;
            color: #1a1a1a;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .blog-search-box {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 0.95rem;
            color: #333;
            transition: all 0.3s ease;
            margin-bottom: 5px;
        }

            .blog-search-box:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .blog-sort-dropdown {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 0.95rem;
            color: #333;
            background-color: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .blog-sort-dropdown:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

        .blog-categories-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .blog-category-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .blog-category-item input[type="checkbox"] {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: #667eea;
            }

            .blog-category-item label {
                cursor: pointer;
                flex-grow: 1;
                color: #333;
                font-size: 0.95rem;
                margin: 0;
                user-select: none;
            }

        /* Right Content Area */
        .blog-content {
            display: flex;
            flex-direction: column;
        }

        .blog-posts-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 30px;
            color: #1a1a1a;
        }

        .blog-posts-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }

        .blog-posts-section {
            padding: 20px 0 60px;
        }

        .blog-posts-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 40px;
            color: #1a1a1a;
            text-align: center;
        }

        .blog-posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
        }

        .blog-post-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 0;
        }

        @@media (max-width: 768px) {
            .blog-post-card {
                grid-template-columns: 1fr;
            }
        }

            .blog-post-card:hover {
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
            }

        .blog-card-image-wrapper {
            position: relative;
            height: 200px;
            overflow: hidden;
            background: #f0f0f0;
        }

        @@media (max-width: 768px) {
            .blog-card-image-wrapper {
                height: 220px;
            }
        }

        .blog-card-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .blog-post-card:hover .blog-card-image {
            transform: scale(1.05);
        }

        .blog-card-categories {
            position: absolute;
            top: 12px;
            right: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .blog-card-category-tag {
            display: inline-block;
            padding: 4px 10px;
            background-color: rgba(102, 126, 234, 0.9);
            color: white;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .blog-card-category-tag:hover {
                background-color: #667eea;
            }

        .blog-card-content {
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            justify-content: space-between;
        }

        .blog-card-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            color: #999;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .blog-card-date {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .blog-card-author {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .blog-card-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: #1a1a1a;
            line-height: 1.4;
        }

            .blog-card-title a {
                color: inherit;
                text-decoration: none;
                transition: color 0.3s ease;
            }

                .blog-card-title a:hover {
                    color: #667eea;
                }

        .blog-card-description {
            font-size: 0.95rem;
            color: #666;
            line-height: 1.6;
            margin-bottom: 20px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .blog-card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .blog-card-read-more {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

            .blog-card-read-more:hover {
                color: #764ba2;
                gap: 12px;
            }

        .blog-empty-state {
            text-align: center;
            padding: 60px 20px;
            grid-column: 1 / -1;
        }

            .blog-empty-state h3 {
                font-size: 1.5rem;
                color: #666;
                margin-bottom: 10px;
            }

            .blog-empty-state p {
                color: #999;
                font-size: 1rem;
            }

        .blog-results-info {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 20px;
        }
    </style>
}

<!-- Main Container -->
<div class="container">
    <div class="blog-container">
        <!-- Left Sidebar - Filters -->
        <aside class="blog-sidebar">
            <form method="get" action="?" id="filterForm">
                <!-- Search Filter -->
                <div class="blog-filter-section">
                    <label class="blog-filter-title">Search Blogs</label>
                    <input type="text" 
                           name="search" 
                           class="blog-search-box" 
                           placeholder="Search by title..."
                           value="@viewModel?.SearchQuery"
                           onchange="document.getElementById('filterForm').submit();">
                </div>

                <!-- Sort Filter -->
                <div class="blog-filter-section">
                    <label class="blog-filter-title">Sort By</label>
                    <select name="sortBy" 
                            class="blog-sort-dropdown"
                            onchange="document.getElementById('filterForm').submit();">
                        <option value="latest" selected="@(viewModel?.SortBy == "latest")">Latest</option>
                        <option value="oldest" selected="@(viewModel?.SortBy == "oldest")">Oldest</option>
                    </select>
                </div>

                <!-- Category Filters -->
                @if (categories.Any())
                {
                    <div class="blog-filter-section">
                        <label class="blog-filter-title">Categories</label>
                        <div class="blog-categories-list">
                            @foreach (var category in categories)
                            {
                                var isChecked = selectedCategories.Contains(category, StringComparer.OrdinalIgnoreCase);
                                <div class="blog-category-item">
                                    <input type="checkbox" 
                                           id="category_@category" 
                                           name="category_@category" 
                                           value="@category"
                                           @(isChecked ? "checked" : "")
                                           onchange="updateCategories()">
                                    <label for="category_@category">@category</label>
                                </div>
                            }
                        </div>
                    </div>
                }
            </form>
        </aside>

        <!-- Right Content - Blog Posts -->
        <main class="blog-content">
            @if (posts.Any())
            {
                <h2 class="blog-posts-title">Latest Blogs</h2>
                <div class="blog-results-info">
                    Showing @((viewModel?.CurrentPage - 1) * 1 + 1) to @Math.Min(viewModel?.CurrentPage * 1 ?? 1, viewModel?.TotalPosts ?? 1) of @viewModel?.TotalPosts results
                </div>

                <div class="blog-posts-grid">
                    @foreach (var post in posts)
                    {
                        <article class="blog-post-card">
                            <div class="blog-card-image-wrapper">
                                @if (post.TeaserImage.LegacyMediaFileAsset != null)
                                {
                                    <img src="@post.TeaserImage.LegacyMediaFileAsset.Url" alt="@post.Title" class="blog-card-image" loading="lazy">
                                }
                                else if (post.TeaserImage.LegacyMediaFileAsset != null)
                                {
                                    <img src="@post.TeaserImage.LegacyMediaFileAsset.Url" alt="@post.Title" class="blog-card-image" loading="lazy">
                                }
                                else
                                {
                                    <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem;">
                                        <i class="fas fa-blog"></i>
                                    </div>
                                }
                                @if (post.BlogCategory?.Any() == true)
                                {
                                    <div class="blog-card-categories">
                                        @foreach (var category in post.BlogCategory.Take(2))
                                        {
                                            <span class="blog-card-category-tag">@category.Title</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="blog-card-content">
                                <div>
                                    <div class="blog-card-meta">
                                        <div class="blog-card-date">
                                            <i class="fas fa-calendar-alt" style="color: #667eea;"></i>
                                            @post.Date.ToString("MMM d, yyyy")
                                        </div>
                                        @if (post.Author != null)
                                        {
                                            <div class="blog-card-author">
                                                <i class="fas fa-user" style="color: #667eea;"></i>
                                                @post.Author.FullName
                                            </div>
                                        }
                                    </div>

                                    <h3 class="blog-card-title">
                                        <a href="@post.LinkPath" title="@post.Title">@post.Title</a>
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(post.ShortDescription))
                                    {
                                        <p class="blog-card-description">@post.ShortDescription</p>
                                    }
                                </div>

                                <div class="blog-card-footer">
                                    <a href="@post.LinkPath" class="blog-card-read-more">
                                        Read More <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <!-- Pagination View Component -->
                @if (viewModel?.TotalPages > 1)
                {
                    <vc:pagination model="viewModel" />
                }
            }
            else
            {
                <div class="blog-empty-state">
                    <h3>No blogs found</h3>
                    <p>Try adjusting your search or filter criteria.</p>
                </div>
            }
        </main>
    </div>
</div>

<script>
    function updateCategories() {
        const form = document.getElementById('filterForm');
        const checkboxes = form.querySelectorAll('input[type="checkbox"]');
        const selectedCategories = [];

        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                selectedCategories.push(checkbox.value);
            }
        });

        const urlParams = new URLSearchParams();
        const searchInput = form.querySelector('input[name="search"]');
        const sortBy = form.querySelector('select[name="sortBy"]');

        if (searchInput && searchInput.value) {
            urlParams.set('search', searchInput.value);
        }
        if (selectedCategories.length > 0) {
            urlParams.set('categories', selectedCategories.join(','));
        }
        if (sortBy && sortBy.value !== 'latest') {
            urlParams.set('sortBy', sortBy.value);
        }
        urlParams.set('page', '1'); // Reset to page 1 when filters change

        const newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
        window.location.href = newUrl;
    }
</script>
