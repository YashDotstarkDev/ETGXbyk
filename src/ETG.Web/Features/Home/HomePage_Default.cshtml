@model ETG.Web.Features.Home.HomePageViewModel

@{
    var pageModel = Model;

    var schema = Model.HomepageJsonSchema ?? "";
    var pattern = @"<script\b[^>]*>([\s\S]*?)</script\s*>";
    var options =
        System.Text.RegularExpressions.RegexOptions.IgnoreCase;

    var blocks = System.Text.RegularExpressions.Regex
        .Matches(schema, pattern, options)
        .Cast<System.Text.RegularExpressions.Match>()
        .Select(m => m.Groups[1].Value)
        .Append(System.Text.RegularExpressions.Regex.Replace(
            schema, pattern, "", options));
}

@section Scripts
{
    @foreach (var block in blocks.Where(
        b => !string.IsNullOrWhiteSpace(b)))
    {
        string? json = null;

        try
        {
            using var doc =
                System.Text.Json.JsonDocument.Parse(block);

            if (doc.RootElement.ValueKind is
                System.Text.Json.JsonValueKind.Object or
                System.Text.Json.JsonValueKind.Array)
            {
                json = System.Text.Json.JsonSerializer.Serialize(
                    doc.RootElement,
                    new System.Text.Json.JsonSerializerOptions
                    {
                        WriteIndented = true
                    });
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Invalid JSON: render nothing.
        }

        if (json is not null)
        {
            @Html.Raw("\n<script type=\"application/ld+json\">\n")
            @Html.Raw(json)
            @Html.Raw("\n</script>\n")
        }
    }
}

<style>
    .proof-points-no-line .section-title::before,
    .proof-points-no-line .section-title::after,
    .proof-points-no-line .title-div::before,
    .proof-points-no-line .title-div::after {
