@model ETG.Web.Features.Home.HomePageViewModel

@{
    var pageModel = Model;

    var schema = Model.HomepageJsonSchema ?? "";
    var pattern = @"<script\b[^>]*>([\s\S]*?)</script\s*>";
    var options =
        System.Text.RegularExpressions.RegexOptions.IgnoreCase;

    var blocks = System.Text.RegularExpressions.Regex
        .Matches(schema, pattern, options)
        .Cast<System.Text.RegularExpressions.Match>()
        .Select(m => m.Groups[1].Value)
        .Append(System.Text.RegularExpressions.Regex.Replace(
            schema, pattern, "", options));
}

@section Scripts
{
    @foreach (var block in blocks.Where(
        b => !string.IsNullOrWhiteSpace(b)))
    {
        string? json = null;

        try
        {
            using var doc =
                System.Text.Json.JsonDocument.Parse(block);

            if (doc.RootElement.ValueKind is
                System.Text.Json.JsonValueKind.Object or
                System.Text.Json.JsonValueKind.Array)
            {
                json = System.Text.Json.JsonSerializer.Serialize(
                    doc.RootElement,
                    new System.Text.Json.JsonSerializerOptions
                    {
                        WriteIndented = true
                    });
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Invalid JSON: render nothing.
        }

        if (json is not null)
        {
            @Html.Raw("\n<script type=\"application/ld+json\">\n")
            @Html.Raw(json)
            @Html.Raw("\n</script>\n")
        }
    }
}

<style>
    .proof-points-no-line .section-title::before,
    .proof-points-no-line .section-title::after,
    .proof-points-no-line .title-div::before,
    .proof-points-no-line .title-div::after {
        display: none !important;
    }

    .proof-points-no-line .section-title {
        border-bottom: none !important;
        text-decoration: none !important;
    }
</style>
<!-- HERO -->
<section class="hero hero-sec-pad" aria-label="Hero">

  @if (Model.HeroImage?.LegacyMediaFileAsset is not null)
{
    <picture>
        <img src="@Url.Content(Model.HeroImage.LegacyMediaFileAsset.Url)"
             alt=""
             class="hero-bg" />
    </picture>
}

    <div class="hero-overlay"></div>

    <div class="container hero-content text-center text-white">

        @if (!string.IsNullOrWhiteSpace(Model.HeroCaption))
        {
            var title = Model.HeroCaption.Trim();
            var lastSpace = title.LastIndexOf(' ');
            var titleStart = lastSpace < 0 ? "" : title[..lastSpace];
            var lastWord = title[(lastSpace + 1)..];

            <h1 class="display-4 fw-bold">
                @if (!string.IsNullOrEmpty(titleStart))
                {
                    @titleStart
                    <text> </text>
                }

                <span class="accent-italic" style="color: #c65391;">
                    @lastWord
                </span>
            </h1>
        }

        @if (!string.IsNullOrWhiteSpace(Model.HeroSubCaption))
        {
            <p>@Model.HeroSubCaption</p>
        }

        <form class="hero-search shadow-lg"
              role="search"
              id="heroSearchForm"
              data-app-id="@Model.SearchAppId"
              data-api-key="@Model.SearchApiKey"
              data-index-name="@Model.SearchIndexName">

            <div class="row g-0 align-items-center">

                <!-- 1. Destination (DYNAMIC from Algolia) -->
                <div class="col-4 col-md-3 search-field">
                    <label class="form-label">Destination</label>

                    <select class="form-select tom-select"
                            aria-label="Destination"
                            id="heroDestination">
                        <option value="all">Select</option>
                    </select>
                </div>

                <!-- 2. Experience (DYNAMIC from Algolia) -->
                <div class="col-4 col-md-3 search-field">
                    <label class="form-label">Experience</label>

                    <select class="form-select tom-select"
                            aria-label="Experience"
                            id="heroExperience">
                        <option value="all">Select</option>
                    </select>
                </div>

                <!-- 3. Keyword -->
                <div class="col-4 col-md-3 search-field">
                    <label class="form-label">Keyword</label>

                    <input type="text"
                           name="Keyword"
                           id="heroKeyword"
                           placeholder="Keyword"
                           class="form-control">
                </div>

                <!-- 4. Button -->
                <div class="col-12 col-md-3 d-grid mt-3 mt-md-0 text-center">
                    <button type="submit"
                            class="btn btn-pink btn-lg search-btn">
                        Find
                    </button>
                </div>

            </div>
        </form>

    </div>
</section>


<!-- WHEN EXPERIENCE MATTERS -->
@if (!string.IsNullOrWhiteSpace(Model.ProofPointsTitle))
{
    <section class="hero-sec-pad hero-sec-pad2 proof-points-no-line">
        <div class="container">
            <div class="d-flex justify-content-center border-0 align-items-end title-div">
                <h2 class="section-title text-center">
                    @Model.ProofPointsTitle
                </h2>
            </div>
        </div>
    </section>
}

<editable-area area-identifier="editableAreaTop" />


<!-- EXPLORE EXPERIENCES -->
@if (Model.Experiences.Count > 0)
{
    <partial name="~/Views/Shared/Partial/Experience/_ExploreExperiences.cshtml"
             model="Model.Experiences" />
}



    <editable-area area-identifier="middle" />
 
    
   
        <editable-area area-identifier="bottom" />
    

<!-- BLOGS -->
@{
    var articles = Model.RelatedArticles?.Take(3).ToList();
}

@if (!string.IsNullOrWhiteSpace(Model.BlogsTitle)
    || !string.IsNullOrWhiteSpace(Model.BlogsDescription)
    || articles?.Any() == true)
{
    <section class="section-pad related-articles-section"
             aria-labelledby="blogs-title">

        <div class="container">

            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

                <div>
                    <h2 id="blogs-title"
                        class="section-title mb-2">
                        @(string.IsNullOrWhiteSpace(Model.BlogsTitle)
                            ? "Travel Blogs & Guides"
                            : Model.BlogsTitle)
                    </h2>

                    <div class="section-title-line"></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.BlogsViewAllUrl))
                {
                    <a href="@Model.BlogsViewAllUrl"
                       class="view-all-btn">
                        View All
                    </a>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.BlogsDescription))
            {
                <div class="related-articles-description mb-4">
                    @Html.Raw(Model.BlogsDescription)
                </div>
            }

            @if (articles?.Any() == true)
            {
                <partial name="~/Views/Shared/Partial/Article/RelatedArticlePartial.cshtml"
                         model="articles" />
            }

        </div>
    </section>
}


    <editable-area area-identifier="bottom2" />          

