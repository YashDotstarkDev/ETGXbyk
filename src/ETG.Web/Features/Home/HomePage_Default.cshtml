<!-- BLOGS -->
@{
    var articles = Model.RelatedArticles?.Take(3).ToList();
}

@if (!string.IsNullOrWhiteSpace(Model.BlogsTitle)
    || !string.IsNullOrWhiteSpace(Model.BlogsDescription)
    || articles?.Any() == true)
{
    <section class="section-pad related-articles-section"
             aria-labelledby="blogs-title">

        <div class="container">

            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

                <div>
                    <h2 id="blogs-title"
                        class="section-title mb-2">
                        @(string.IsNullOrWhiteSpace(Model.BlogsTitle)
                            ? "Travel Blogs & Guides"
                            : Model.BlogsTitle)
                    </h2>

                    <div class="section-title-line"></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.BlogsViewAllUrl))
                {
                    <a href="@Model.BlogsViewAllUrl"
                       class="view-all-btn">
                        View All
                    </a>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.BlogsDescription))
            {
                <div class="related-articles-description mb-4">
                    @Html.Raw(Model.BlogsDescription)
                </div>
            }

            @if (articles?.Any() == true)
            {
                <partial name="~/Views/Shared/Partial/Article/RelatedArticlePartial.cshtml"
                         model="articles" />
            }

        </div>
    </section>
}



