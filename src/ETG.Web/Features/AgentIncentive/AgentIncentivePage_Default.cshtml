@section Styles
{
    @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))
    {
        <link rel="preload" fetchpriority="high" as="image" href="@Model.HeroImageUrl.Imgixify(1920, 600)" media="(min-width: 768px)" />
        <link rel="preload" fetchpriority="high" as="image" href="@Model.HeroImageUrl.Imgixify(768, 960)" media="(max-width: 767px)" />
    }
}
@using ETG.Web.Features.AgentIncentive

@using Kentico.Content.Web.Mvc.PageBuilder

@using Kentico.PageBuilder.Web.Mvc


@model AgentIncentivePageViewModel


@if (Model is not null)

{

    <vc:bread-crumb />
    <section class="hero tahiti-hero"
             aria-label="@($"{Model.Heading} hero banner")">

        @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))

        {

            <picture>
                <source media="(max-width: 767px)"
                        srcset="@Model.HeroImageUrl.ImgixSrcset(768, 960, null)"
                        width="768"
                        height="960" />
                <img src="@Model.HeroImageUrl.Imgixify(1920, 600)"
                     srcset="@Model.HeroImageUrl.ImgixSrcset(1920, 600, new[] { 1 })"
                     alt="@Model.HeroImageAlt"
                     width="1920"
                     height="600"
                     loading="eager"
                     fetchpriority="high"
                     decoding="async"
                     class="hero-bg" />
            </picture>
        }


        <div class="hero-overlay tahiti-hero__overlay"></div><div class="container text-white">
        <div class="tahiti-hero__content">
            <h1 class="tahiti-hero__title">
                @Model.Heading

            </h1>
        </div>
    </div>
</section>
}

<editable-area area-identifier="Content" />