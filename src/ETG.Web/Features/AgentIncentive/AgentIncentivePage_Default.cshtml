@using ETG.Web.Features.AgentIncentive

@using Kentico.Content.Web.Mvc.PageBuilder

@using Kentico.PageBuilder.Web.Mvc


@model AgentIncentivePageViewModel


@if (Model is not null)

{

    <vc:bread-crumb />
    <section class="hero tahiti-hero"
             aria-label="@($"{Model.Heading} hero banner")">

        @if (!string.IsNullOrWhiteSpace(Model.HeroImageUrl))

        {

            <picture>
                <img src="@Model.HeroImageUrl"
                     alt="@Model.HeroImageAlt"
                     class="hero-bg" />
            </picture>
        }


        <div class="hero-overlay tahiti-hero__overlay"></div><div class="container text-white">
        <div class="tahiti-hero__content">
            <h1 class="tahiti-hero__title">
                @Model.Heading

            </h1>
        </div>
    </div>
</section>
}

<editable-area area-identifier="Content" />