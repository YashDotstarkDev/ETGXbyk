@using CMS.Websites
@using ETG.Core.Content
@using ETG.Web.Features.TourPackage
@using Kentico.Content.Web.Mvc.PageBuilder
@model TourPageTemplateController.TourPageTemplateViewModel

@{
    var pageData  = Model;


    if (pageData == null)
    {
        return;
    }
    var tour = pageData.Tour;
    var currentUrl = pageData.CurrentUrl;
    var tourMapImage = tour.TourMapImage?.OfType<MediaFile>().FirstOrDefault();
    var tourHeroImage = tour.TourHeroImage?.OfType<MediaFile>().FirstOrDefault();
    var partnershipFolders = pageData.PartnershipFolders
        ?? Enumerable.Empty<Folder>();

    var itineraryItems = tour.SelectedItineraryFolders?
        .Where(x => x != null)
        .SelectMany(x => x.SelectedTourItineraries ?? Enumerable.Empty<ETG.TourItinerary>())
        .Where(x => x != null)
        .ToList()
        ?? new List<ETG.TourItinerary>();


    ViewData["ShareLinks"] = pageData.ShareLinks;

    var destinations = Model.Destinations
        ?? Enumerable.Empty<dynamic>();
    var destination = destinations.FirstOrDefault();

    var reviews = Model.Reviews;
    double averageRating = reviews?.Totals.AverageRating ?? 0;
    int reviewCount = reviews?.Totals.ReviewCount ?? 0;
    int fullStars = (int)Math.Floor(averageRating);
    bool halfStar = (averageRating - fullStars) >= 0.5;
    int emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
}

<vc:bread-crumb/>



<script type="application/ld+json">
    {
         "@@context": "https://schema.org",
         "@@type": "TouristTrip",
         "name": "@(tour.TourName)",
         "description": "@(@tour.TourSummary)",
         "touristType": [
           "@tour.TourTypes"
         ],
         "offers": {
           "@@type": "Offer",
           "name": "@(tour.TourName) - @(tour.TourCode)",
           "price": "@(tour.SelectedTourPricingFolders?.FirstOrDefault()?.SelectedTourPricings?.FirstOrDefault()?.TourPricingOverridePrice)",
           "priceCurrency": "AUD",
           "url": "https://www.entiretravel.com.au/@currentUrl",
           "eligibleRegion": {
             "@@type": "Country",
             "name": "AU"
           },
           "offeredBy": {
             "@@type": "Organization",
             "name": "Entire Travel Group",
             "url": "https://www.entiretravel.com.au"
           }
         },
         "itinerary": {
             "@@type": "ItemList",
             "numberOfItems": "@tour.TourNights",
             "itemListElement": [
             @{
                 var listItems = "";
             }
              @if (itineraryItems.Any())
               {
                 var inCounter = 0;
                 @for (var i = 0; i < itineraryItems.Count; i++)
                  {
                   var itinerary = itineraryItems[i];
                   {
                     inCounter++;
                     listItems += $"{{\"@type\" : \"ListItem\", \"position\" : {inCounter}, \"item\" : {{ \"@type\" : \"TouristAttraction\", \"name\" : \"{itinerary.TourItineraryTitle}\" }} }},";
                   }
                 }
               }
             ]
         }
    }
</script>

<script type="application/ld+json">
    {
         "@@context": "https://schema.org",
         "@@type": "Product",
         "name": "@(tour.TourName)",
         "url": "https://www.entiretravel.com.au/@currentUrl",
         "description": "@(@tour.TourSummary)",
         "image": "@(tourHeroImage?.LegacyMediaFileAsset?.Url ?? "")",
         "sku":"@(tour.TourCode)",
         "Mpn":"@(tour.TourCode)",
         "offers": {
           "@@type": "Offer",
           "url": "https://www.entiretravel.com.au/@currentUrl",
           "availability": "http://schema.org/OnlineOnly",
           "price": "@(tour.SelectedTourPricingFolders?.FirstOrDefault()?.SelectedTourPricings?.FirstOrDefault()?.TourPricingOverridePrice)",
           "priceCurrency": "AUD"
           }
    }
</script>
<!-- FAQ schema -->
@if (tour?.TourFAQFolder != null && tour.TourFAQFolder.Any())
{
    <!-- FAQ schema -->
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "FAQPage",
            "mainEntity": [
            @{
              var faqSchemaIndex = 0;
            }

            @foreach (var faq in tour.TourFAQFolder)
            {
                 if (faqSchemaIndex > 0)
                 {
                   @:,
                 }
                 <text>
                     {
                         "@@type": "Question",
                         "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(faq.FAQQuestion)),
                         "acceptedAnswer": {
                         "@@type": "Answer",
                         "text": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(faq.FAQAnswer))
                         }
                     }
                 </text>
                  faqSchemaIndex++;
            }
            ]
        }
    </script>
}

<partial name="~/Views/Shared/Partial/Tour/_TourHeroImageWithSlider.cshtml"
         model="tour" />

@if (!string.IsNullOrWhiteSpace(destination?.DestinationName)
    || !string.IsNullOrWhiteSpace(tour?.TourPriceCurrency))
{

    <div class="pkg-header-wrapper border-top border-info border-2" style="background-color: #fff9fb;">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center py-3 pkg-header-row">
                <h2 class="pkg-title m-0">@(destination?.DestinationName ?? tour?.TourPriceCurrency ?? "") | Tour Code: <span class="text-pink">@(tour?.TourCode ?? "")</span></h2>
            </div>
        </div>
    </div>
}

<section class="section-pad package-details-section pt-4 pkg-details-bg">
    <div class="container">
        <div class="row g-5">
            <!-- Left Column -->
            <div class="col-lg-8">

                <div class="pkgd-tabs-bar">
                    <div class="pkgd-tabs-bar__inner">
                        <ul class="nav pkgd-tabs-bar__nav">
                            @if (!string.IsNullOrWhiteSpace(tour.TourDetails))
                            {
                             <li class="nav-item" data-label="overview" data-mobile-visible="true">
                                 <a class="nav-link active" href="#pkg-overview">OVERVIEW</a>
                             </li>
                            }

                            @if (tour?.SelectedTourHighlightFolders != null &&
                             tour.SelectedTourHighlightFolders.Any(folder =>
                                 folder?.SelectedTourHighlilghts != null &&
                                 folder.SelectedTourHighlilghts.Any()))
                            {
                             <li class="nav-item" data-label="highlights" data-mobile-visible="true">
                                 <a class="nav-link" href="#pkg-highlights">HIGHLIGHTS</a>
                             </li>
                            }
                            @if (tour.SelectedTourHighlightFolders != null && tour.SelectedTourHighlightFolders.Any())
                            {
                                @if (tour?.SelectedTourHighlightFolders != null &&
                                     tour.SelectedTourHighlightFolders.Any(folder =>
                                     folder?.SelectedTourBonuses != null &&
                                     folder.SelectedTourBonuses.Any()))
                                {
                                    <li class="nav-item" data-label="highlights" data-mobile-visible="true">
                                        <a class="nav-link" href="#pkg-entire-bonus">Entire Bonus</a>
                                    </li>
                                }
                            }
                            @if (tour?.SelectedInclusionFolders != null &&
                             tour.SelectedInclusionFolders.Any(f => f?.SelectedTourInclusions != null &&
                                            f.SelectedTourInclusions.Any()))
                             {
                             <li class="nav-item" data-label="inclusions">
                                 <a class="nav-link" href="#pkg-inclusions">INCLUSIONS</a>
                             </li>
                             }

                            @if (itineraryItems.Any())
                             {
                              <li class="nav-item" data-label="itinerary" data-mobile-visible="true">
                                  <a class="nav-link" href="#pkg-itinerary">ITINERARY</a>
                              </li>
                             }
                            @if (tour?.Selecteddocumentlinkfolders != null &&
                                  tour.Selecteddocumentlinkfolders.Any(folder =>
                                      folder?.SelectedDocumentLinks != null &&
                                      folder.SelectedDocumentLinks.Any(link =>
                                                      link?.LinkDocumentGuid != null &&
                             link.LinkDocumentGuid.Any(hotel => hotel != null))))
                             {
                             <li class="nav-item" data-label="accommodation">
                                 <a class="nav-link" href="#pkg-accommodation">ACCOMMODATION</a>
                             </li>
                             }                            

                            @if (tour?.SelectedOptionalExtrasFolders != null &&
                                 tour.SelectedOptionalExtrasFolders.Any(f => f?.SelectedOptionalExtrases != null &&
                                                f.SelectedOptionalExtrases.Any()))
                             {
                            <li class="nav-item" data-label="optional-extras" data-always-more="true" style="display: none;">
                                <a class="nav-link" href="#pkg-optional-extras">OPTIONAL EXTRAS</a>
                            </li>
                             }

                             @if (!string.IsNullOrWhiteSpace(tour.TourImportantNote))
                             {
                             <li class="nav-item" data-label="additional" data-always-more="true" style="display: none;">
                                 <a class="nav-link" href="#pkg-additional">ADDITIONAL INFORMATION</a>
                             </li>
                             }
                            @if (!string.IsNullOrWhiteSpace(tour.TourExclusions))
                            {
                                <li class="nav-item" data-label="excluded" data-always-more="true" style="display: none;">
                                    <a class="nav-link" href="#pkg-excluded">Excluded</a>
                                </li>
                            }
                            @if (tour.TourFAQFolder != null && tour.TourFAQFolder.Any())
                            {
                                <li class="nav-item" data-label="faqs">
                                    <a class="nav-link" href="#pkg-faqs">FAQs</a>
                                </li>
                            }
                            <li class="nav-item pkgd-more-menu">
                                <button type="button" class="pkgd-more-btn" aria-expanded="false">
                                    MORE
                                    <span class="pkgd-more-arrow">▼</span>
                                </button>
                                <div class="pkgd-more-dropdown">
                                    @if (!string.IsNullOrWhiteSpace(tour.TourDetails))
                                    {
                                        <a href="#pkg-overview" data-label="overview">OVERVIEW</a>
                                    }
                                    @if (tour?.SelectedTourHighlightFolders != null &&
                             tour.SelectedTourHighlightFolders.Any(folder =>
                                 folder?.SelectedTourHighlilghts != null &&
                                 folder.SelectedTourHighlilghts.Any()))
                                    {
                                        <a href="#pkg-highlights" data-label="highlights">HIGHLIGHTS</a>
                                    }
                                    @if (tour?.SelectedInclusionFolders != null &&
                             tour.SelectedInclusionFolders.Any(f => f?.SelectedTourInclusions != null &&
                                            f.SelectedTourInclusions.Any()))
                                    {
                                     <a href="#pkg-inclusions" data-label="inclusions">INCLUSIONS</a>                                        
                                    }
                                    @if (itineraryItems.Any())
                                    {
                                    <a href="#pkg-itinerary" data-label="itinerary">ITINERARY</a>                                        
                                    }
                                    @if (tour?.Selecteddocumentlinkfolders != null &&
                                           tour.Selecteddocumentlinkfolders.Any(folder =>
                                               folder?.SelectedDocumentLinks != null &&
                                               folder.SelectedDocumentLinks.Any(link =>
                                                               link?.LinkDocumentGuid != null &&
                                      link.LinkDocumentGuid.Any(hotel => hotel != null))))
                                    {
                                    <a href="#pkg-accommodation" data-label="accommodation">ACCOMMODATION</a>                                        
                                    }
                                    
                                    @if (tour?.SelectedOptionalExtrasFolders != null &&
                                 tour.SelectedOptionalExtrasFolders.Any(f => f?.SelectedOptionalExtrases != null &&
                                                f.SelectedOptionalExtrases.Any()))
                                    {
                                    <a href="#pkg-optional-extras" data-label="optional-extras" data-always-more="true">OPTIONAL EXTRAS</a>                                        
                                    }
                                    @if (!string.IsNullOrWhiteSpace(tour.TourImportantNote))
                                    {
                                    <a href="#pkg-additional" data-label="additional" data-always-more="true">ADDITIONAL INFORMATION</a>                                        
                                    }
                                    @if (!string.IsNullOrWhiteSpace(tour.TourExclusions))
                                    {
                                        <a href="#pkg-excluded" data-label="excluded" data-always-more="true">Excluded</a>
                                    }
                                    @if (tour.TourFAQFolder != null && tour.TourFAQFolder.Any())
                                    {
                                        <a href="#pkg-faqs" data-label="faqs">FAQs</a>
                                    }
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="bg-white border rounded-3 p-3 p-md-4 mb-5 shadow-sm">
                    <!-- Info Bar (moved inside white card) -->
                    <div class="pkg-info-bar d-flex flex-wrap mb-4 pkgd-info-bar-top" id="pkg-package">
                        @if (!string.IsNullOrWhiteSpace(tour.TourDepartsFromInAustralia))
                        {
                            <div class="pkg-info-item">
                                <div class="pkg-info-label">STARTS AND ENDS</div>
                                @if (!string.IsNullOrWhiteSpace(tour.TourDepartsFromInAustralia) && !string.IsNullOrWhiteSpace(tour.TourTravelEnds) && tour.TourDepartsFromInAustralia == tour.TourTravelEnds)
                                {
                                    <div class="pkg-info-value text-muted">in @tour.TourDepartsFromInAustralia</div>
                                }
                                else
                                {
                                    <div class="pkg-info-value text-muted value--start-end">
                                        @tour.TourDepartsFromInAustralia To
                                        <br />
                                        @tour.TourTravelEnds
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(tour.TourTravelDates))
                        {
                            <div class="pkg-info-item">
                                <div class="pkg-info-label">TRAVEL PERIODS</div>
                                <div class="pkg-info-value text-muted">@tour.TourTravelDates</div>
                            </div>
                        }

                        @if (tour.TourExperiences != null && tour.TourExperiences.Any())
                        {
                            <div class="pkg-info-item">
                                <div class="pkg-info-label">EXPERIENCE</div>

                                <div class="pkg-info-value text-muted">
                                    @foreach (var experience in pageData.Experiences)
                                    {
                                        <div>
                                            <a href="@experience.GetUrl().RelativePath"
                                               class="text-pink text-decoration-none">
                                                @if (!string.IsNullOrWhiteSpace(experience.ExperienceIcon))
                                                {
                                                    <span class="icon @experience.ExperienceIcon"></span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(experience.ExperienceName))
                                                {
                                                  <span class="text-pink">@experience.ExperienceName</span>
                                                }                                                
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (tour.TourTypes != null && tour.TourTypes.Any())
                        {
                            var tourType = tour.TourTypes.FirstOrDefault();
                            if (tourType != null)
                            {
                                <div class="pkg-info-item">
                                    <div class="pkg-info-label">TRAVEL STYLE</div>
                                    <div class="pkg-info-value text-muted">
                                        @pageData.TourTypeNames.FirstOrDefault()
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(tour.TourSummary))
                    {
                        <p class="pkg-intro-text mb-4"> @tour.TourSummary</p>
                    }

                     <!-- Section: Overview -->
                    @if (!string.IsNullOrWhiteSpace(tour.TourDetails))
                    {
                        <div id="pkg-overview" class="pkg-section mb-5">
                            <h3 class="pkg-section-title">Overview</h3>
                            <p class="pkg-body-text pkg-body-text-styled">@Html.Raw(tour.TourDetails)</p>
                            @if (tourMapImage?.LegacyMediaFileAsset?.Url != null)
                            {                                
                                <img src="@(tourMapImage?.LegacyMediaFileAsset?.Url ?? "")"
                                     alt="Tour Map"
                                     class="pkg-overview-image">
                            }
                        </div>
                    }

                    <!-- Highlights -->
                    @if (tour.SelectedTourHighlightFolders != null && tour.SelectedTourHighlightFolders.Any())
                    {
                        @if (tour?.SelectedTourHighlightFolders != null &&
                             tour.SelectedTourHighlightFolders.Any(folder =>
                                 folder?.SelectedTourHighlilghts != null &&
                                 folder.SelectedTourHighlilghts.Any()))
                        {
                            <div id="pkg-highlights" class="pkg-section mb-5">
                            <h4 class="pkg-section-title" >Highlights</h4>
                            <ul class="pkg-inclusions-list list-unstyled">
                                @foreach (var highlightitems in tour.SelectedTourHighlightFolders)
                                {
                                    if (highlightitems.SelectedTourHighlilghts != null &&
                                        highlightitems.SelectedTourHighlilghts.Any())
                                    {
                                        foreach (var items in highlightitems.SelectedTourHighlilghts)
                                        {
                                            <li class="inclusion-item">

                                                <span class="inclusion-icon-wrapper">
                                                    @if (!string.IsNullOrWhiteSpace(items.TourHighlightIcon))
                                                    {
                                                        <span class="icon @items.TourHighlightIcon"></span>
                                                    }
                                                </span>
                                                <span class="inclusion-text">@Html.Raw(@items.TourHighlightLabel)</span>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                            </div>
                        }
                    }

                    <hr class="pkgd-section-divider">

                    @if (tour.SelectedTourHighlightFolders != null && tour.SelectedTourHighlightFolders.Any())
                    {
                        @if (tour?.SelectedTourHighlightFolders != null &&
                             tour.SelectedTourHighlightFolders.Any(folder =>
                             folder?.SelectedTourBonuses != null &&
                             folder.SelectedTourBonuses.Any()))
                        {
                            <!-- Section: Inclusions -->
                            <div id="pkg-entire-bonus" class="pkg-section mb-5">
                                <h3 class="pkg-section-title">Entire Bonus</h3>
                                <ul class="pkg-inclusions-list list-unstyled">
                                    @foreach (var entirebonus in tour.SelectedTourHighlightFolders)
                                    {
                                        if (entirebonus.SelectedTourBonuses != null &&
                                            entirebonus.SelectedTourBonuses.Any())
                                        {
                                            foreach (var bonus in entirebonus.SelectedTourBonuses)
                                            {
                                                <li class="inclusion-item">
                                                    <span class="inclusion-icon-wrapper">
                                                        @if (!string.IsNullOrWhiteSpace(bonus.TourHighlightIcon))
                                                        {
                                                            <span class="icon @bonus.TourHighlightIcon"></span>
                                                        }
                                                    </span>
                                                    <span class="inclusion-text">@Html.Raw(@bonus.TourHighlightLabel)</span>
                                                </li>
                                            }
                                        }
                                    }
                                </ul>
                            </div>
                        }
                        <hr class="pkgd-section-divider">
                    }

                   
                      @if (tour?.SelectedInclusionFolders != null &&
                             tour.SelectedInclusionFolders.Any(f => f?.SelectedTourInclusions != null &&
                                            f.SelectedTourInclusions.Any()))
                    {
                        <!-- Section: Inclusions -->
                        <div id="pkg-inclusions" class="pkg-section mb-5">
                            <h3 class="pkg-section-title">Inclusions</h3>

                            <ul class="pkg-inclusions-list list-unstyled">

                                @foreach (var inclusionFolder in tour.SelectedInclusionFolders)
                                {
                                    if (inclusionFolder.SelectedTourInclusions != null &&
                                        inclusionFolder.SelectedTourInclusions.Any())
                                    {
                                        foreach (var inclusion in inclusionFolder.SelectedTourInclusions)
                                        {
                                            <li class="inclusion-item">

                                                <span class="inclusion-icon-wrapper">
                                                    @if (!string.IsNullOrWhiteSpace(inclusion.TourInclusionIcon))
                                                    {
                                                        <span class="icon @inclusion.TourInclusionIcon"></span>
                                                    }
                                                </span>

                                                <span class="inclusion-text">
                                                    @inclusion.TourInclusionLabel
                                                </span>

                                            </li>
                                        }
                                    }
                                }

                            </ul>
                        </div>
                    }


                    @if (itineraryItems.Any())
                    {
                        <!-- Section: Itinerary -->
                        <div id="pkg-itinerary" class="pkg-section mb-5">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h3 class="pkg-section-title m-0">
                                    Itinerary
                                </h3>

                                <div class="itinerary-actions small fw-bold d-flex gap-3">

                                    @if (!string.IsNullOrWhiteSpace(tour.TourCode))
                                    {
                                        <a href="/pdf/@tour.TourCode"
                                           class="link-pink text-uppercase text-decoration-none"
                                           target="_blank">
                                            DOWNLOAD ITINERARY
                                        </a>
                                    }

                                    <button type="button" id="expandAll"
                                            class="link-pink text-uppercase text-decoration-none border-0 bg-transparent p-0">
                                        EXPAND ALL
                                    </button>

                                </div>
                            </div>


                            <div class="accordion pkg-accordion" id="itineraryAccordion">

                                @for (var i = 0; i < itineraryItems.Count; i++)
                                {
                                    var itinerary = itineraryItems[i];

                                    var collapseId = $"itineraryDay{i + 1}";
                                    var headingId = $"itineraryHeading{i + 1}";

                                    <div class="accordion-item">

                                        <h2 class="accordion-header" id="@headingId">

                                            <button class="accordion-button collapsed"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="false"
                                                    aria-controls="@collapseId">

                                                @if (!string.IsNullOrWhiteSpace(
                                                    itinerary.TourItineraryDayCaption))
                                                {
                                                    <span class="text-dark fw-bold me-2">
                                                        @itinerary.TourItineraryDayCaption
                                                    </span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                    itinerary.TourItineraryTitle))
                                                {
                                                    <span>
                                                        @itinerary.TourItineraryTitle
                                                    </span>
                                                }

                                            </button>

                                        </h2>


                                        <div id="@collapseId"
                                             class="accordion-collapse collapse"
                                             aria-labelledby="@headingId"
                                             data-bs-parent="#itineraryAccordion">

                                            <div class="accordion-body">

                                                @* Details *@
                                                @if (!string.IsNullOrWhiteSpace(
                                                    itinerary.TourItineraryDetail))
                                                {
                                                    <div class="itinerary-detail">
                                                        @Html.Raw(itinerary.TourItineraryDetail)
                                                    </div>
                                                }


                                                @* Inclusion *@
                                                @if (!string.IsNullOrWhiteSpace(
                                                    itinerary.TourItineraryInclusion))
                                                {
                                                    <div class="inclusions mt-3">

                                                        <div class="item d-flex align-items-center gap-2">

                                                            <span class="icon fal fa-utensils"></span>

                                                            <span>
                                                                @itinerary.TourItineraryInclusion
                                                            </span>

                                                        </div>

                                                    </div>
                                                }


                                                @* Freedom of Choice *@
                                                @if (itinerary.SelectedFreedomOfChoiceOptions != null &&
                                                     itinerary.SelectedFreedomOfChoiceOptions.Any())
                                                {
                                                    <div class="freedom-of-choice mt-4">

                                                        <p>
                                                            <strong>Freedom of Choice Options</strong>
                                                        </p>

                                                        @foreach (var foc in itinerary.SelectedFreedomOfChoiceOptions)
                                                        {
                                                            <ul>
                                                                <li>
                                                                    @foc
                                                                </li>
                                                            </ul>
                                                        }

                                                    </div>
                                                }
                                                @if (itinerary.TourItineraryImage != null && itinerary.TourItineraryImage.Any())
                                                {
                                                    var itineraryImage = itinerary.TourItineraryImage.OfType<MediaFile>().FirstOrDefault();

                                                    var imageUrl = itineraryImage?.LegacyMediaFileAsset?.Url;
                                                    if (itineraryImage != null)
                                                    {
                                                      <div class="inner-content">
                                                            <div class="image mt-4">

                                                                <img class="lazyload"
                                                                     src="@Url.Content(imageUrl)"
                                                                     alt="@itinerary.TourItineraryTitle" />

                                                                <div class="grad"></div>

                                                                @if (!string.IsNullOrWhiteSpace(
                                                                    itinerary.TourItineraryImageCaption))
                                                                {
                                                                    <div class="caption">
                                                                        <i class="bi bi-geo-alt"></i>
                                                                        @itinerary.TourItineraryImageCaption
                                                                    </div>
                                                                }

                                                            </div>
                                                      </div>
                                                    }
                                                }

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }
                    @if (tour.TourHasPeaceOfMindGuarantee)
                    {
                    <editable-area area-identifier="Zone1" />                        
                    }

                    @if (tour?.Selecteddocumentlinkfolders != null &&
                         tour.Selecteddocumentlinkfolders.Any(folder =>
                             folder?.SelectedDocumentLinks != null &&
                             folder.SelectedDocumentLinks.Any(link =>
                                             link?.LinkDocumentGuid != null &&
                                             link.LinkDocumentGuid.Any(hotel => hotel != null))))
                    {
                        <div id="pkg-accommodation" class="pkg-section mb-5">
                            <div class="scroll-section">
                                <div class="widget package-hotels" data-widget="package-hotels" style="opacity: 1;">
                                    <h2 class="pkg-section-title">Accommodation</h2>

                                    <div class="ui styled fluid accordion hotels">
                                        @foreach (var documentLinkFolder in tour.Selecteddocumentlinkfolders)
                                        {
                                            if (documentLinkFolder?.SelectedDocumentLinks == null)
                                            {
                                                continue;
                                            }

                                            foreach (var documentLink in documentLinkFolder.SelectedDocumentLinks)
                                            {
                                                if (documentLink?.LinkDocumentGuid == null)
                                                {
                                                    continue;
                                                }

                                                foreach (var hotel in documentLink.LinkDocumentGuid)
                                                {
                                                        if (hotel == null)
                                                        {
                                                            continue;
                                                        }

                                                        decimal review = 0;
                                                        decimal.TryParse(
                                                            hotel.HotelReview,
                                                            System.Globalization.NumberStyles.Any,
                                                            System.Globalization.CultureInfo.InvariantCulture,
