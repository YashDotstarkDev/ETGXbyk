{
<div class="connect-bar text-center">
    <div class="ticker-wrapper">
        <!-- Scrolling Marquee -->
        <div class="ticker">
            <div class="ticker-track" id="tickerTrack">
            @if (pageData.Promotion != null)
                {
                    var promotion = pageData.Promotion;
                    var discountText = promotion.PromotionDollarDiscount > 0
                        ? $"SAVE ${promotion.PromotionDollarDiscount}PP"
                        : promotion.PromotionPercentDiscount > 0
                            ? $"SAVE {promotion.PromotionPercentDiscount:0}%"
                            : string.Empty;

                    <div class="marque-item"> @discountText </div>
                    <div class="marque-item">LIMITED TIME ONLY</div>
                    <div class="marque-item">@promotion.PromotionName</div>
                }
                else if (pageData.Discount != null)
                {
                    var discount = pageData.Discount;
                    <div class="marque-item">@discount.DiscountHeading</div>
                    <div class="marque-item">LIMITED TIME ONLY</div>
                    <div class="marque-item">@discount.DiscountHeading</div>

                 }
              </div>
            </div>
            <!-- Bottom row -->
            <div class="bottom-row">
                <a href="/enquire"
                   class="btn-enquire-footer">
                    Enquire Now
                </a>
                @if (reviews != null)
                {
                    <div class="google-rating">
                        <div class="google-top">
                            <a href="/google-reviews"
                               target="_blank"
                               rel="noopener noreferrer">
                                <img src="/images/google-review-logo.png"
                                     alt="Google"
                                     class="google-logo" />
                            </a>
                            <div class="google-content">
                                <div class="stars"
                                     aria-label="@averageRating out of 5 stars">
                                    @for (int i = 0; i < fullStars; i++)
                                    {
                                        <span aria-hidden="true">&#9733;</span>
                                    }
                                    @if (halfStar)
                                    {
                                        <span aria-hidden="true">&#11242;</span>
                                    }
                                    @for (int i = 0; i < emptyStars; i++)
                                    {
                                        <span aria-hidden="true">&#9734;</span>
                                    }
                                </div>
                                <div class="reviews">
                                    @averageRating.ToString("0.0") Stars,
                                    @reviewCount
                                    Review@(reviewCount == 1 ? "" : "s")
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>       
       }
  </div>
</div>
}
else
{
  <vc:sticky-bar />
}



<script>
    document.addEventListener("DOMContentLoaded", function() {

        const countdownElement = document.getElementById("countdown-timer");

        if (!countdownElement) {
            return;
        }

        const fromDateValue = countdownElement.getAttribute("data-from-date");
        const toDateValue = countdownElement.getAttribute("data-to-date");

        if (!fromDateValue || !toDateValue) {
            return;
        }

        const fromDate = new Date(fromDateValue);
        const toDate = new Date(toDateValue);

        function formatTime(milliseconds) {

            const totalSeconds = Math.max(
                0,
                Math.floor(milliseconds / 1000)
            );

            const days = Math.floor(totalSeconds / 86400);

            const hours = Math.floor(
                (totalSeconds % 86400) / 3600
            );

            const minutes = Math.floor(
                (totalSeconds % 3600) / 60
            );

            const seconds = totalSeconds % 60;

            return (
                String(days).padStart(2, "0") + ":" +
                String(hours).padStart(2, "0") + ":" +
                String(minutes).padStart(2, "0") + ":" +
                String(seconds).padStart(2, "0")
            );
        }

        function updateCountdown() {

            const now = new Date();

            // Promotion has not started yet
            if (now < fromDate) {
                const timeUntilStart = fromDate - now;

                countdownElement.textContent =
                    formatTime(timeUntilStart);

                return;
            }

            // Promotion is currently active
            if (now >= fromDate && now < toDate) {
                const timeRemaining = toDate - now;

                countdownElement.textContent =
                    formatTime(timeRemaining);

                return;
            }

            // Promotion has expired
            countdownElement.textContent = "00:00:00:00";
        }

        // Run immediately
        updateCountdown();

        // Update every second
        setInterval(updateCountdown, 1000);
    });
</script>