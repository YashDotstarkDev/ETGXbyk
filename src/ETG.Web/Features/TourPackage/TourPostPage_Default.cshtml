                                                                                      style="color: #CA568E;">
                                                                                    @for (int i = 1; i <= 5; i++)
                                                                                    {
                                                                                        if (review >= i)
                                                                                        {
                                                                                            <text>★</text>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <text>☆</text>
                                                                                        }
                                                                                    }
                                                                                </span>
                                                                            </span>
                                                                        }
                                                                        @hotel.HotelName
