                        @* @await Html.PartialAsync("Partial/Tour/_TourNoBookNowSidebar", model: (tour, pageData.PriceInfo)) *@
                        @await Html.PartialAsync("Partial/Tour/_TourNoBookNowSidebar",model: (tour, pageData.PriceInfo, pageData.Promotion, pageData.Discount))

                        <div class="partnership-widget">
                        @if (partnershipFolders.Any())
                        {
                            
                                <h5 class="partnership-title">IN PARTNERSHIP WITH</h5>
                                <div class="partnership-logos">
                                    @foreach (var folder in partnershipFolders)
                                    {
                                        if (folder?.SelectedCTAImages == null)
                                        {
                                            continue;
                                        }
                                        foreach (var partner in folder.SelectedCTAImages)
                                        {
                                            if (partner == null)
                                            {
                                                continue;
                                            }
                                            var image = partner.CTAImageImagePath?.OfType<MediaFile>().FirstOrDefault();

                                           @if (image?.LegacyMediaFileAsset?.Url != null)
                                           {
                                               <div class="partnership-logo-wrapper">
                                                   <img src="@image.LegacyMediaFileAsset.Url" alt="@partner.CTAImageImageAltText" class="partnership-logo">
                                               </div>
                                           }
                                        }
                                    }
                                </div>   
                            
                        }
                         @if (!string.IsNullOrWhiteSpace(tour.TourTravelSubjectLine))
                         {
