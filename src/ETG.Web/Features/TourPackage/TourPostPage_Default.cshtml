                            <h3 class="pkg-section-title mb-3">Additional Information</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="additional-info-box">
                                        <div class="info-label text-uppercase small text-white opacity-75">OFFICIAL LANGUAGE</div>
                                        <div class="info-val text-white fw-medium">@(destination?.DestinationOfficialLanguages ?? "")</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="additional-info-box">
                                        <div class="info-label text-uppercase small text-white opacity-75">LOCAL CURRENCY</div>
                                        <div class="info-val text-white fw-medium">@(destination?.DestinationCurrency ?? "")</div>
                                    </div>
                                </div>
                            </div>
                            <br />
                            @Html.Raw(tour.TourImportantNote)
                            @Html.Raw(tour.TourSmallprint)
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(tour.TourExclusions))
                    {
                        <!-- Section: Excluded -->
                        <div class="pkg-section mb-5" id="pkg-excluded">
                            <h3 class="pkg-section-title mb-3">Excluded</h3>
                            @Html.Raw(tour.TourExclusions)
                        </div>
                    }
                </div>

                <!-- ============ Tour Page (FAQ) ============ -->
                @if (tour.TourFAQFolder != null && tour.TourFAQFolder.Any())
                {
                    <section class="section-pad pkg-section" aria-labelledby="faq-title" id="pkg-faqs">
                        <div class="container">
                            <div class="title-div mb-4">
                                <div class="d-flex flex-row justify-content-between align-items-center gap-3">
                                    <h2 id="faq-title" class="section-title mb-0">FAQs</h2>
                                    <a href="/faqs" class="view-all-btn"> View All </a>
                                </div>
                            </div>                           

                            <div class="accordion" id="faqAccordion">
                                @if (tour?.TourFAQFolder != null && tour.TourFAQFolder.Any())
                                {
                                    <div class="accordion" id="faqAccordion">
                                        @{
                                            var faqIndex = 1;
                                        }
                                        @foreach (var faq in tour.TourFAQFolder)
                                        {
                                            var faqId = $"faq{faqIndex}";
                                            var headingId = $"heading{faqIndex}";

                                            <div class="accordion-item">
                                                <h3 class="accordion-header" id="@headingId">
                                                    <button class="accordion-button collapsed"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@faqId"
                                                            aria-expanded="false"
                                                            aria-controls="@faqId">
                                                        @faq.FAQQuestion
                                                    </button>
                                                </h3>
                                                <div id="@faqId"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="@headingId"
                                                     data-bs-parent="#faqAccordion">
                                                    <div class="accordion-body">
                                                        @Html.Raw(faq.FAQAnswer)
                                                    </div>
                                                </div>
                                            </div>
                                            faqIndex++;
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                }
