@using System
@using System.Linq
@using ETG.Web.Features.Destinations
@model DestinationLandingPageViewModel

@{
    var pageModel = Model;

    var heading = pageModel.Page.Heading?.Trim() ?? "";

    var headingParts = heading.Split(
        ' ',
        StringSplitOptions.RemoveEmptyEntries);

    var headingPrefix = headingParts.Length > 1
        ? string.Join(
            " ",
            headingParts.Take(headingParts.Length - 1))
        : "";

    var headingHighlight =
        headingParts.LastOrDefault() ?? "";
}

@if (!string.IsNullOrWhiteSpace(pageModel.ContainerJsonSchema))
{
    <script type="application/ld+json">
        @Html.Raw(pageModel.ContainerJsonSchema)
    </script>
}

@section Styles
{
    @if (pageModel.Page.HeroImage?.LegacyMediaFileAsset is not null)
    {
        <link rel="preload" fetchpriority="high" as="image" href="@pageModel.Page.HeroImage.Imgixify(1920, 600)" media="(min-width: 768px)" />
        <link rel="preload" fetchpriority="high" as="image" href="@pageModel.Page.HeroImage.Imgixify(768, 960)" media="(max-width: 767px)" />
    }
}

<vc:bread-crumb />

<div class="about-page">
    <section class="about-hero position-relative">
        @if (pageModel.Page.HeroImage?.LegacyMediaFileAsset is not null)
        {
            <picture>
                <source media="(max-width: 767px)"
                        srcset="@pageModel.Page.HeroImage.ImgixSrcset(768, 960, null)"
                        width="768"
                        height="960" />
                <img src="@pageModel.Page.HeroImage.Imgixify(1920, 600)"
                     srcset="@pageModel.Page.HeroImage.ImgixSrcset(1920, 600, new[] { 1 })"
                     alt="@pageModel.Page.HeroImageAltText"
                     width="1920"
                     height="600"
                     class="about-hero-img w-100 object-fit-cover"
                     fetchpriority="high"
                     loading="eager"
                     decoding="async" />
            </picture>
        }

        <div class="about-hero-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-end justify-content-center">
            @if (!string.IsNullOrWhiteSpace(heading))
            {
                <h1 class="about-hero-title text-white fw-bold display-4"
                    style="font-size: 50px;">
                    @if (!string.IsNullOrWhiteSpace(headingPrefix))
                    {
                        @headingPrefix
                        <span> </span>
                    }

                    <span class="text-pink"
                          style="font-size: 50px;">
                        @headingHighlight
                    </span>
                </h1>
            }
        </div>
    </section>

   
        <editable-area area-identifier="LandingBody" />
   


    <div class="about-container">
        @if (pageModel.Categories.Any())
        {
            @await Html.PartialAsync(
                "~/Views/Shared/Partial/Destination/_DestinationLandingListing.cshtml",
                pageModel.Categories)
        }
    </div>

   
        <editable-area area-identifier="Bottom" />
    
