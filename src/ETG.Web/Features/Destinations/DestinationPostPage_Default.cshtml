    {
        @pageModel.DestinationRelatedArticlesHeader
    }
    else
    {
        <text>Read what we've written on @pageModel.DestinationHeading</text>
    }
</h2>

                    <div class="section-title-line"></div>
                </div>

                <a href="/articles" class="view-all-btn">
                    View All
                </a>
            </div>

            <p class="related-articles-description mb-4">
                Inspiration, tips and travel stories from our team
                of experts to help you plan your next unforgettable
                journey.
            </p>

            <partial name="~/Views/Shared/Partial/Article/RelatedArticlePartial.cshtml"
                     model="relatedArticles.Take(3).ToList()" />
        </div>
    </section>
}


@if (sticky is not null && sticky.DisplaySticky
